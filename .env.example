# ===================================================================
# MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env) - PHARMACHAIN MANAGEMENT SYSTEM
# Sao chép nội dung này vào file .env hoặc BE/sba/.env và điền thông tin thật
# ===================================================================

# 1. Cấu hình gửi Mail thông báo (Gmail App Password)
EMAIL_NAME=your_email@gmail.com
EMAIL_PASSWORD=your_16_digit_app_password

# 2. Cấu hình Cổng thanh toán PayOS (Tạo VietQR & Tự động xác nhận)
# Đăng nhập https://my.payos.vn/ -> Kênh thanh toán -> Thông tin kết nối để lấy:
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

