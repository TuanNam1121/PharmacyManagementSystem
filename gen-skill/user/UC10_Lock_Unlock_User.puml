@startuml
' --- VISUAL PARADIGM STYLE CONFIGURATION ---
skinparam Style strictuml
skinparam SequenceMessageAlignment left
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' Cấu hình Participant: Màu nền xanh nhạt, chữ đen, không in đậm
skinparam Participant {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
    Padding 5
}

skinparam Actor {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Database {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Sequence {
    ' Tô màu xanh cho các thanh kích hoạt (activation boxes)
    LifeLineBackgroundColor #A0D8EF
    LifeLineBorderColor #000000

    ArrowColor #000000
    ArrowFontColor #000000
    ArrowFontSize 11

    BoxBackgroundColor #A0D8EF
    BoxBorderColor #000000
    BoxFontColor #000000
}

skinparam Note {
    BackgroundColor #FFF9E6
    BorderColor #000000
    FontColor #000000
}

skinparam LifeLineStrategy solid

' --- ACTORS & PARTICIPANTS ---
actor "Admin" as Admin
participant "<<boundary>>\nUsersPage" as UsersPage
participant "<<boundary>>\nUserLockModal" as UserLockModal
participant "<<control>>\nAccountController" as AccountController
participant "<<control>>\nAccountService" as AccountService
participant "Database" as Database

' --- STEP 1 & 2: INITIATE LOCK/UNLOCK ---
Admin -> UsersPage : 1: Click "Lock/Unlock" button on a user row
activate UsersPage

UsersPage -> UserLockModal : 2: Open Lock/Unlock confirmation modal with target user info
deactivate UsersPage
activate UserLockModal

UserLockModal --> Admin : 3: Display modal (prompt for confirmation and lock reason if locking)

' --- STEP 2 VALIDATION: SELF-LOCK CHECK ---
alt Admin attempts to lock own account (AT01)
    Admin -> UserLockModal : 4: Confirm lock on current logged-in account
    UserLockModal -> AccountController : 5: updateAccountStatus(userId, status=LOCKED, reason)
    activate AccountController

    AccountController -> AccountService : 6: updateAccountStatus(userId, status, reason)
    activate AccountService

    AccountService -> AccountService : 7: Check if target userId matches current session Admin ID
    AccountService --> AccountController : 8: Throw BusinessException("Cannot lock your own account")
    deactivate AccountService

    AccountController --> UserLockModal : 9: Return 400 Bad Request / Forbidden
    deactivate AccountController

    UserLockModal --> Admin : 10: Display error alert "Self-lock action is restricted"

else Admin cancels action (AT02)
    Admin -> UserLockModal : 11: Click "Cancel" button
    UserLockModal -> UsersPage : 12: Close modal and abort request
    deactivate UserLockModal
    activate UsersPage
    UsersPage --> Admin : 13: Retain current account status in user directory
    deactivate UsersPage

else Confirmed valid status update
    Admin -> UserLockModal : 14: Input lock reason (if locking) and click "Confirm"
    activate UserLockModal

    UserLockModal -> AccountController : 15: updateAccountStatus(userId, status, reason)
    activate AccountController

    AccountController -> AccountService : 16: updateAccountStatus(userId, status, reason)
    activate AccountService

    AccountService -> Database : 17: Query target Account by ID
    activate Database

    Database --> AccountService : 18: Return Account entity
    deactivate Database

    AccountService -> Database : 19: Update status (LOCKED or ACTIVE) in accounts table
    activate Database
    Database --> AccountService : 20: Status updated in database

    alt Account is being Locked
        AccountService -> Database : 21: Invalidate active refresh tokens / session tokens for user
        Database --> AccountService : 22: Session tokens invalidated
    end

    AccountService -> Database : 23: Record status change and reason in System Audit Log
    Database --> AccountService : 24: Audit log entry saved
    deactivate Database

    AccountService --> AccountController : 25: Return void / success status
    deactivate AccountService

    AccountController --> UserLockModal : 26: Return 200 OK with success message
    deactivate AccountController

    UserLockModal -> UsersPage : 27: Close modal and refresh user list
    deactivate UserLockModal
    activate UsersPage

    UsersPage --> Admin : 28: Present success notification and updated user status
    deactivate UsersPage
end

@enduml