@startuml
' --- VISUAL PARADIGM STYLE CONFIGURATION ---
skinparam Style strictuml
skinparam SequenceMessageAlignment left
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' Cấu hình Participant: Màu nền xanh nhạt, chữ đen, không in đậm
skinparam Participant {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
    Padding 5
}

skinparam Actor {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Database {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Sequence {
    ' Tô màu xanh cho các thanh kích hoạt (activation boxes)
    LifeLineBackgroundColor #A0D8EF
    LifeLineBorderColor #000000

    ArrowColor #000000
    ArrowFontColor #000000
    ArrowFontSize 11

    BoxBackgroundColor #A0D8EF
    BoxBorderColor #000000
    BoxFontColor #000000
}

skinparam Note {
    BackgroundColor #FFF9E6
    BorderColor #000000
    FontColor #000000
}

skinparam LifeLineStrategy solid

' --- ACTORS & PARTICIPANTS ---
actor "Admin" as Admin
participant "<<boundary>>\nUsersPage" as UsersPage
participant "<<boundary>>\nUserRoleModal" as UserRoleModal
participant "<<control>>\nAccountController" as AccountController
participant "<<control>>\nAccountService" as AccountService
participant "Database" as Database

' --- STEP 1 & 2: SELECT USER & OPEN ASSIGN ROLE MODAL ---
Admin -> UsersPage : 1: Click "Assign Role" action on a user
activate UsersPage

UsersPage -> AccountController : 2: getAccountDetail(userId)
activate AccountController

AccountController -> AccountService : 3: getAccountDetail(userId)
activate AccountService

AccountService -> Database : 4: Query user details and current role/permissions
activate Database

Database --> AccountService : 5: Return Account with Role details
deactivate Database

AccountService --> AccountController : 6: Return AccountDetailResponse
deactivate AccountService

AccountController --> UsersPage : 7: Return 200 OK
deactivate AccountController

UsersPage -> UserRoleModal : 8: Open modal with user info and roles list
deactivate UsersPage
activate UserRoleModal

UserRoleModal --> Admin : 9: Display Assign Role modal (read-only user info, role dropdown)

' --- STEP 3: ROLE SELECTION & DYNAMIC PERMISSIONS PREVIEW ---
Admin -> UserRoleModal : 10: Select Role from dropdown
UserRoleModal -> UserRoleModal : 11: Dynamically render Permissions Summary preview for selected role

alt Admin cancels assignment (AT02)
    Admin -> UserRoleModal : 12: Click "Cancel" button
    UserRoleModal -> UsersPage : 13: Close modal without saving changes
    deactivate UserRoleModal
    activate UsersPage
    UsersPage --> Admin : 14: Retain existing user directory view
    deactivate UsersPage

else Admin confirms role assignment
    Admin -> UserRoleModal : 15: Click "Save Role" button
    activate UserRoleModal

    UserRoleModal -> AccountController : 16: assignRole(userId, RoleAssignRequest(roleId))
    activate AccountController

    AccountController -> AccountService : 17: assignRole(userId, roleId)
    activate AccountService

    ' --- STEP 4: VALIDATION OF SELF-DEMOTION ---
    AccountService -> AccountService : 18: Validate self-demotion rule (currentSessionUserId == targetUserId && newRole != ADMIN)

    alt Self-demotion attempt detected (AT01)
        AccountService --> AccountController : 19: Throw BusinessException("Self-demotion of Admin role is forbidden")
        deactivate AccountService

        AccountController --> UserRoleModal : 20: Return 403 Forbidden with error message
        deactivate AccountController

        UserRoleModal --> Admin : 21: Display error alert "Cannot revoke Administrator privileges from own account"
    else Validation successful
        AccountService -> Database : 22: Update account role_id in accounts table
        activate Database

        Database --> AccountService : 23: Role updated successfully

        AccountService -> Database : 24: Record event in System Audit Log (Action=ASSIGN_ROLE)
        Database --> AccountService : 25: Audit log persisted
        deactivate Database

        AccountService --> AccountController : 26: Return updated AccountResponse
        activate AccountService
        deactivate AccountService

        AccountController --> UserRoleModal : 27: Return 200 OK with success payload
        activate AccountController
        deactivate AccountController

        UserRoleModal -> UsersPage : 28: Close modal and trigger user list refresh
        deactivate UserRoleModal
        activate UsersPage

        UsersPage --> Admin : 29: Display success notification "Role successfully assigned" and refresh list
        deactivate UsersPage
    end
end

@enduml