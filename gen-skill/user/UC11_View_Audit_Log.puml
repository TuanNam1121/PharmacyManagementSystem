@startuml
' --- VISUAL PARADIGM STYLE CONFIGURATION ---
skinparam Style strictuml
skinparam SequenceMessageAlignment left
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' Cấu hình Participant: Màu nền xanh nhạt, chữ đen, không in đậm
skinparam Participant {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
    Padding 5
}

skinparam Actor {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Database {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Sequence {
    ' Tô màu xanh cho các thanh kích hoạt (activation boxes)
    LifeLineBackgroundColor #A0D8EF
    LifeLineBorderColor #000000

    ArrowColor #000000
    ArrowFontColor #000000
    ArrowFontSize 11

    BoxBackgroundColor #A0D8EF
    BoxBorderColor #000000
    BoxFontColor #000000
}

skinparam Note {
    BackgroundColor #FFF9E6
    BorderColor #000000
    FontColor #000000
}

skinparam LifeLineStrategy solid

' --- ACTORS & PARTICIPANTS ---
actor "Admin" as Admin
participant "<<boundary>>\nHomepage" as Homepage
participant "<<boundary>>\nAuditLogPage" as AuditLogPage
participant "<<control>>\nAuditLogController" as AuditLogController
participant "<<control>>\nAuditLogService" as AuditLogService
participant "Database" as Database

' --- STEP 1: ACCESS AUDIT LOG ---
Admin -> Homepage : 1: Select "Audit Log" navigation option
activate Homepage

Homepage -> AuditLogPage : 2: Navigate to AuditLogPage
deactivate Homepage
activate AuditLogPage

' --- STEP 2: AUTHORIZATION & INITIAL FETCH ---
AuditLogPage -> AuditLogController : 3: getAuditLogs(startDate, endDate, module, action, page, size)
activate AuditLogController

AuditLogController -> AuditLogService : 4: getAuditLogs(filterParams)
activate AuditLogService

AuditLogService -> AuditLogService : 5: Verify user has Administrator authorization

alt Unauthorized Access Attempt (AT03)
    AuditLogService -> Database : 6: Record UNAUTHORIZED_ACCESS_ATTEMPT in security log
    activate Database
    Database --> AuditLogService : 7: Security event logged
    deactivate Database

    AuditLogService --> AuditLogController : 8: Throw AccessDeniedException("Unauthorized access")
    deactivate AuditLogService

    AuditLogController --> AuditLogPage : 9: Return 403 Forbidden
    deactivate AuditLogController

    AuditLogPage --> Admin : 10: Display error "Access Denied" and redirect
else Authorized Admin user
    AuditLogService -> Database : 11: Query audit log storage (default: last 30 days, timestamp DESC)
    activate Database

    Database --> AuditLogService : 12: Return audit log records
    deactivate Database

    AuditLogService --> AuditLogController : 13: Return PageResponse<AuditLogResponse>
    activate AuditLogService
    deactivate AuditLogService

    AuditLogController --> AuditLogPage : 14: Return 200 OK with audit log data
    deactivate AuditLogController

    AuditLogPage --> Admin : 15: Present audit log table and search/filter controls

    ' --- STEP 4 & 5: FILTER AUDIT LOG ---
    Admin -> AuditLogPage : 16: Input filter criteria (Date Range, Target Module, Action Type, User ID)

    alt Invalid Date Range Filter (AT02)
        AuditLogPage -> AuditLogPage : 17: Validate date range (startDate > endDate)
        AuditLogPage --> Admin : 18: Display error "Start date cannot be later than end date"
    else Valid Filter Parameters
        AuditLogPage -> AuditLogController : 19: getAuditLogs(filteredCriteria)
        activate AuditLogController

        AuditLogController -> AuditLogService : 20: getAuditLogs(filteredCriteria)
        activate AuditLogService

        AuditLogService -> Database : 21: Query audit records matching filtered criteria
        activate Database

        alt No records match criteria (AT01)
            Database --> AuditLogService : 22: Return empty result set
            deactivate Database

            AuditLogService --> AuditLogController : 23: Return empty PageResponse
            deactivate AuditLogService

            AuditLogController --> AuditLogPage : 24: Return 200 OK (empty list)
            deactivate AuditLogController

            AuditLogPage --> Admin : 25: Display informational alert "No audit log entries found"
        else Matching records found
            Database --> AuditLogService : 26: Return filtered records
            activate Database
            deactivate Database

            AuditLogService --> AuditLogController : 27: Return PageResponse<AuditLogResponse>
            activate AuditLogService
            deactivate AuditLogService

            AuditLogController --> AuditLogPage : 28: Return 200 OK with filtered audit entries
            activate AuditLogController
            deactivate AuditLogController

            AuditLogPage --> Admin : 29: Present updated audit log table

            ' --- STEP 6 & 7: EXPORT AUDIT TRAIL ---
            Admin -> AuditLogPage : 30: Request audit log export (CSV / Excel)

            AuditLogPage -> AuditLogController : 31: exportAuditLogs(filteredCriteria)
            activate AuditLogController

            AuditLogController -> AuditLogService : 32: generateAuditExportFile(filteredCriteria)
            activate AuditLogService

            AuditLogService -> Database : 33: Query complete filtered audit records for export
            activate Database
            Database --> AuditLogService : 34: Return records dataset
            deactivate Database

            AuditLogService -> AuditLogService : 35: Compile and format export file (CSV/Excel)
            AuditLogService --> AuditLogController : 36: Return export file byte resource
            deactivate AuditLogService

            AuditLogController --> AuditLogPage : 37: Return 200 OK with file download payload
            deactivate AuditLogController

            AuditLogPage --> Admin : 38: Trigger file download for compliance archiving
        end
    end
end

deactivate AuditLogPage

@enduml