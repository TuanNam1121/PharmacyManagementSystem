@startuml
' --- VISUAL PARADIGM STYLE CONFIGURATION ---
skinparam Style strictuml
skinparam SequenceMessageAlignment left
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' Cấu hình Participant: Màu nền xanh nhạt, chữ đen, không in đậm
skinparam Participant {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
    Padding 5
}

skinparam Actor {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Database {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Sequence {
    ' Tô màu xanh cho các thanh kích hoạt (activation boxes)
    LifeLineBackgroundColor #A0D8EF
    LifeLineBorderColor #000000

    ArrowColor #000000
    ArrowFontColor #000000
    ArrowFontSize 11

    BoxBackgroundColor #A0D8EF
    BoxBorderColor #000000
    BoxFontColor #000000
}

skinparam Note {
    BackgroundColor #FFF9E6
    BorderColor #000000
    FontColor #000000
}

skinparam LifeLineStrategy solid

' --- ACTORS & PARTICIPANTS ---
actor "Admin" as Admin
participant "<<boundary>>\nUsersPage" as UsersPage
participant "<<boundary>>\nUserFormModal" as UserFormModal
participant "<<control>>\nAccountController" as AccountController
participant "<<control>>\nAccountService" as AccountService
participant "Database" as Database

' --- STEP 1 & 2: INITIATE USER CREATION ---
Admin -> UsersPage : 1: Click "Add User" button
activate UsersPage

UsersPage -> UserFormModal : 2: Open "Add User" modal with empty form fields
deactivate UsersPage
activate UserFormModal

UserFormModal --> Admin : 3: Display creation form (Full Name, Phone, Email, Username, Password)

' --- STEP 3: SUBMISSION OR CANCELLATION ---
alt Admin cancels creation (AT03)
    Admin -> UserFormModal : 4: Click "Cancel" button
    UserFormModal --> Admin : 5: Prompt confirmation to discard unsaved data
    Admin -> UserFormModal : 6: Confirm discard
    UserFormModal -> UsersPage : 7: Close modal and return to user directory
    deactivate UserFormModal
    activate UsersPage
    UsersPage --> Admin : 8: Display user directory without saving changes
    deactivate UsersPage

else Admin submits form
    Admin -> UserFormModal : 9: Enter user information and click "Submit"
    activate UserFormModal

    UserFormModal -> UserFormModal : 10: Validate required fields on client-side

    alt Client-side validation failure / missing fields (AT01)
        UserFormModal --> Admin : 11: Highlight incomplete fields and prompt valid input
    else Validation passed on UI
        UserFormModal -> AccountController : 12: createAccount(AccountCreateRequest)
        activate AccountController

        AccountController -> AccountService : 13: createAccount(request)
        activate AccountService

        AccountService -> Database : 14: Check uniqueness of username, email, and phone
        activate Database

        alt Duplicate Username, Email, or Phone exists (AT02)
            Database --> AccountService : 15: Return conflicting record found
            deactivate Database

            AccountService --> AccountController : 16: Throw DuplicateResourceException("Identifier already exists")
            deactivate AccountService

            AccountController --> UserFormModal : 17: Return 400 Bad Request with error details
            deactivate AccountController

            UserFormModal --> Admin : 18: Display error message "Username/Email/Phone already exists"
        else Identifiers are unique
            Database --> AccountService : 19: Return uniqueness verified (no conflicts)
            activate Database

            AccountService -> AccountService : 20: Hash initial password with BCrypt
            activate AccountService
            deactivate AccountService

            AccountService -> Database : 21: Insert new Account record (status=ACTIVE)
            Database --> AccountService : 22: Account record created successfully

            AccountService -> Database : 23: Insert System Audit Log entry (Action=CREATE_USER)
            Database --> AccountService : 24: Audit record persisted
            deactivate Database

            AccountService --> AccountController : 25: Return AccountResponse DTO
            activate AccountService
            deactivate AccountService

            AccountController --> UserFormModal : 26: Return 201 Created with created user data
            activate AccountController
            deactivate AccountController

            UserFormModal -> UsersPage : 27: Close modal and trigger directory refresh
            deactivate UserFormModal
            activate UsersPage

            UsersPage --> Admin : 28: Present success notification and updated user directory
            deactivate UsersPage
        end
    end
end

@enduml