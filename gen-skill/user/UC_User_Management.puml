@startuml
skinparam style strictuml
skinparam SequenceMessageAlignment left

actor "Admin" as Admin
participant "<<boundary>>\nHomepage" as Homepage
participant "<<boundary>>\nUsersPage" as UsersPage
participant "<<boundary>>\nUserFormModal" as UserFormModal
participant "<<boundary>>\nUserRoleModal" as UserRoleModal
participant "<<boundary>>\nUserLockModal" as UserLockModal
participant "<<control>>\nAccountController" as AccountController
participant "<<control>>\nAccountService" as AccountService
participant "Database" as Database

' --- 1. ACCESS & VIEW USER DIRECTORY ---
Admin -> Homepage : 1: Select "User Management"
activate Homepage

Homepage -> UsersPage : 2: Navigate to UsersPage
deactivate Homepage
activate UsersPage

UsersPage -> AccountController : 3: getAccounts(keyword, status, roleId, page, size)
activate AccountController

AccountController -> AccountService : 4: getAccounts(keyword, status, roleId, page, size)
activate AccountService

AccountService -> Database : 5: Query user accounts from database
activate Database

alt No user accounts found
    Database --> AccountService : 6: Return empty result
    deactivate Database

    AccountService --> AccountController : 7: Return empty PageResponse
    deactivate AccountService

    AccountController --> UsersPage : 8: Return 200 OK (empty list)
    deactivate AccountController

    UsersPage --> Admin : 9: Display "No users found"

else User accounts retrieved
    Database --> AccountService : 10: Return accounts list
    activate Database
    deactivate Database

    AccountService --> AccountController : 11: Return PageResponse<AccountResponse>
    activate AccountService
    deactivate AccountService

    AccountController --> UsersPage : 12: Return 200 OK with accounts data
    activate AccountController
    deactivate AccountController

    UsersPage --> Admin : 13: Render User List table

    ' --- 2. CREATE NEW USER ---
    Admin -> UsersPage : 14: Click "Add User" button
    UsersPage -> UserFormModal : 15: Open creation modal
    activate UserFormModal

    Admin -> UserFormModal : 16: Fill in user details and submit
    UserFormModal -> AccountController : 17: createAccount(AccountCreateRequest)
    activate AccountController

    AccountController -> AccountService : 18: createAccount(request)
    activate AccountService

    AccountService -> Database : 19: Check uniqueness and insert new account
    activate Database
    Database --> AccountService : 20: New user persisted
    deactivate Database

    AccountService --> AccountController : 21: Return AccountResponse
    deactivate AccountService

    AccountController --> UserFormModal : 22: Return 201 Created
    deactivate AccountController

    UserFormModal -> UsersPage : 23: Close modal and refresh list
    deactivate UserFormModal

    ' --- 3. ASSIGN ROLE ---
    Admin -> UsersPage : 24: Click "Assign Role" for user
    UsersPage -> UserRoleModal : 25: Open Assign Role modal
    activate UserRoleModal

    Admin -> UserRoleModal : 26: Select Role from dropdown and click Save
    UserRoleModal -> AccountController : 27: assignRole(userId, RoleAssignRequest(roleId))
    activate AccountController

    AccountController -> AccountService : 28: assignRole(userId, roleId)
    activate AccountService

    AccountService -> Database : 29: Update user role in database
    activate Database
    Database --> AccountService : 30: Role updated
    deactivate Database

    AccountService --> AccountController : 31: Return updated AccountResponse
    deactivate AccountService

    AccountController --> UserRoleModal : 32: Return 200 OK
    deactivate AccountController

    UserRoleModal -> UsersPage : 33: Close modal and refresh list
    deactivate UserRoleModal

    ' --- 4. LOCK / UNLOCK USER ---
    Admin -> UsersPage : 34: Click "Lock/Unlock" action
    UsersPage -> UserLockModal : 35: Open confirmation modal
    activate UserLockModal

    Admin -> UserLockModal : 36: Enter lock reason and confirm
    UserLockModal -> AccountController : 37: updateAccountStatus(userId, status, reason)
    activate AccountController

    AccountController -> AccountService : 38: updateAccountStatus(userId, status, reason)
    activate AccountService

    AccountService -> Database : 39: Update status to LOCKED and record audit log
    activate Database
    Database --> AccountService : 40: Status updated in database
    deactivate Database

    AccountService --> AccountController : 41: Return success
    deactivate AccountService

    AccountController --> UserLockModal : 42: Return 200 OK
    deactivate AccountController

    UserLockModal -> UsersPage : 43: Close modal and refresh table
    deactivate UserLockModal

    UsersPage --> Admin : 44: Display updated user directory with notifications
end

deactivate UsersPage

@enduml
