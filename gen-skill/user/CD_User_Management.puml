@startuml
skinparam classAttributeIconSize 0
skinparam style strictuml
hide empty members

' ====================================================================
' MODULE USER / ACCOUNT MANAGEMENT CLASS DIAGRAM (COMET METHOD)
' ====================================================================

' --------------------------------------------------------------------
' 1. TẦNG CONTROLLER (<<control>>)
' --------------------------------------------------------------------
class AccountController <<control>> {
  - accountService: AccountService
  + createAccount(request: AccountCreateRequest): ResponseEntity<ApiResponse<AccountResponse>>
  + updateAccount(id: Long, request: AccountUpdateRequest): ResponseEntity<ApiResponse<AccountResponse>>
  + assignRole(id: Long, request: RoleAssignRequest): ResponseEntity<ApiResponse<AccountResponse>>
  + getAccountDetail(id: Long): ResponseEntity<ApiResponse<AccountDetailResponse>>
  + getAccounts(keyword: String, status: Short, roleId: Integer, page: int, size: int, sortBy: String, sortDir: String): ResponseEntity<ApiResponse<PageResponse<AccountResponse>>>
  + updateAccountStatus(id: Long, status: Short, reason: String): ResponseEntity<ApiResponse<Void>>
}

class RoleController <<control>> {
  - roleService: RoleService
  + getAllRoles(): ResponseEntity<ApiResponse<List<RoleDto>>>
  + getRolePermissions(id: Integer): ResponseEntity<ApiResponse<List<PermissionDto>>>
}

class AuditLogController <<control>> {
  - auditLogService: AuditLogService
  + getAuditLogs(startDate: LocalDate, endDate: LocalDate, module: String, action: Short, page: int, size: int): ResponseEntity<ApiResponse<PageResponse<AuditLogResponse>>>
}

' --------------------------------------------------------------------
' 2. TẦNG SERVICE (<<interface>> & <<control>> Impl)
' --------------------------------------------------------------------
interface AccountService <<interface>> {
  + createAccount(request: AccountCreateRequest): AccountResponse
  + updateAccount(id: Long, request: AccountUpdateRequest): AccountResponse
  + assignRole(id: Long, roleId: Integer): AccountResponse
  + getAccountDetail(id: Long): AccountDetailResponse
  + getAccounts(keyword: String, status: Short, roleId: Integer, page: int, size: int, sortBy: String, sortDir: String): PageResponse<AccountResponse>
  + updateAccountStatus(id: Long, status: Short, reason: String): void
  + updateAccountStatus(id: Long, status: Short): void
}

class AccountServiceImpl <<control>> {
  - accountRepository: AccountRepository
  - accountInformationRepository: AccountInformationRepository
  - roleRepository: RoleRepository
  - rolePermissionRepository: RolePermissionRepository
  - passwordEncoder: PasswordEncoder
  + createAccount(request: AccountCreateRequest): AccountResponse
  + updateAccount(id: Long, request: AccountUpdateRequest): AccountResponse
  + assignRole(id: Long, roleId: Integer): AccountResponse
  + getAccountDetail(id: Long): AccountDetailResponse
  + getAccounts(keyword: String, status: Short, roleId: Integer, page: int, size: int, sortBy: String, sortDir: String): PageResponse<AccountResponse>
  + updateAccountStatus(id: Long, status: Short, reason: String): void
  + updateAccountStatus(id: Long, status: Short): void
  - mapToAccountResponse(account: Account): AccountResponse
}

interface RoleService <<interface>> {
  + getAllRoles(): List<RoleDto>
  + getRolePermissions(roleId: Integer): List<PermissionDto>
}

class RoleServiceImpl <<control>> {
  - roleRepository: RoleRepository
  - rolePermissionRepository: RolePermissionRepository
  + getAllRoles(): List<RoleDto>
  + getRolePermissions(roleId: Integer): List<PermissionDto>
}

interface AuditLogService <<interface>> {
  + getAuditLogs(startDate: LocalDate, endDate: LocalDate, module: String, action: Short, page: int, size: int): PageResponse<AuditLogResponse>
  + recordAuditLog(accountId: Long, action: Short, entityName: String, entityId: Long, oldValue: String, newValue: String, ipAddress: String): void
}

class AuditLogServiceImpl <<control>> {
  - auditLogRepository: AuditLogRepository
  - accountRepository: AccountRepository
  + getAuditLogs(startDate: LocalDate, endDate: LocalDate, module: String, action: Short, page: int, size: int): PageResponse<AuditLogResponse>
  + recordAuditLog(accountId: Long, action: Short, entityName: String, entityId: Long, oldValue: String, newValue: String, ipAddress: String): void
}

' --------------------------------------------------------------------
' 3. TẦNG REPOSITORY (<<interface>>)
' --------------------------------------------------------------------
interface AccountRepository <<interface>> {
  + findByUsername(username: String): Optional<Account>
  + findByEmail(email: String): Optional<Account>
  + existsByUsername(username: String): boolean
  + existsByEmail(email: String): boolean
  + existsByPhone(phone: String): boolean
  + existsByEmailAndIdNot(email: String, id: Long): boolean
  + existsByPhoneAndIdNot(phone: String, id: Long): boolean
  + findByIdWithDetails(id: Long): Optional<Account>
  + findAccountsWithFilters(keyword: String, status: AccountStatus, roleId: Integer, pageable: Pageable): Page<Account>
  + save(account: Account): Account
  + findById(id: Long): Optional<Account>
}

interface AccountInformationRepository <<interface>> {
  + findByAccountId(accountId: Long): Optional<AccountInformation>
  + save(accountInformation: AccountInformation): AccountInformation
}

interface RoleRepository <<interface>> {
  + findByCode(code: String): Optional<Role>
  + findAll(): List<Role>
  + findById(id: Integer): Optional<Role>
}

interface RolePermissionRepository <<interface>> {
  + findAllByRoleIdWithPermission(roleId: Integer): List<RolePermission>
  + save(rolePermission: RolePermission): RolePermission
}

interface AuditLogRepository <<interface>> {
  + findByAccountId(accountId: Long, pageable: Pageable): Page<AuditLog>
  + findAll(pageable: Pageable): Page<AuditLog>
  + save(auditLog: AuditLog): AuditLog
}

' --------------------------------------------------------------------
' 4. TẦNG ENTITY & ENUM (<<entity>>, <<enum>>)
' --------------------------------------------------------------------
class Account <<entity>> {
  - id: Long
  - username: String
  - email: String
  - phone: String
  - password: String
  - status: AccountStatus
  - lastLoginAt: LocalDateTime
  - failedLoginCount: Integer
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
  - role: Role
  - accountInformation: AccountInformation
}

class AccountInformation <<entity>> {
  - id: Long
  - account: Account
  - fullName: String
  - dateOfBirth: LocalDate
  - gender: Short
  - address: String
  - avatarUrl: String
}

class Role <<entity>> {
  - id: Integer
  - code: String
  - name: String
  - description: String
}

class Permission <<entity>> {
  - id: Integer
  - code: String
  - module: String
  - description: String
}

class RolePermission <<entity>> {
  - id: RolePermissionId
  - role: Role
  - permission: Permission
}

class RolePermissionId <<entity>> {
  - roleId: Integer
  - permissionId: Integer
}

class AuditLog <<entity>> {
  - id: Long
  - account: Account
  - action: Short
  - entityName: String
  - entityId: Long
  - oldValue: String
  - newValue: String
  - ipAddress: String
  - createdAt: LocalDateTime
}

enum AccountStatus <<enum>> {
  + ACTIVE : 1
  + DISABLED : 0
  + LOCKED : 2
  - code: Short
  - label: String
  + getCode(): Short
  + getLabel(): String
  + fromCode(code: Short): AccountStatus
}

' --------------------------------------------------------------------
' 5. TẦNG DTO (Data Transfer Objects)
' --------------------------------------------------------------------
class AccountCreateRequest <<dto>> {
  - username: String
  - email: String
  - phone: String
  - password: String
  - fullName: String
  - dateOfBirth: LocalDate
  - gender: Short
  - address: String
  - avatarUrl: String
  - roleId: Integer
  - status: Short
}

class AccountUpdateRequest <<dto>> {
  - email: String
  - phone: String
  - fullName: String
  - dateOfBirth: LocalDate
  - gender: Short
  - address: String
  - avatarUrl: String
  - roleId: Integer
}

class RoleAssignRequest <<dto>> {
  - roleId: Integer
}

class AccountResponse <<dto>> {
  - id: Long
  - username: String
  - email: String
  - phone: String
  - status: Short
  - statusLabel: String
  - createdAt: LocalDateTime
  - fullName: String
  - avatarUrl: String
  - roleId: Integer
  - roleCode: String
  - roleName: String
}

class AccountDetailResponse <<dto>> {
  - id: Long
  - username: String
  - email: String
  - phone: String
  - status: Short
  - statusLabel: String
  - lastLoginAt: LocalDateTime
  - failedLoginCount: Integer
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
  - fullName: String
  - dateOfBirth: LocalDate
  - gender: Short
  - address: String
  - avatarUrl: String
  - role: RoleDto
  - permissions: List<String>
}

class RoleDto <<dto>> {
  - id: Integer
  - code: String
  - name: String
  - description: String
  - permissions: List<String>
  - permissionDetails: List<PermissionDto>
}

class PermissionDto <<dto>> {
  - id: Integer
  - code: String
  - module: String
  - description: String
}

class AuditLogResponse <<dto>> {
  - id: Long
  - accountId: Long
  - username: String
  - action: Short
  - entityName: String
  - entityId: Long
  - oldValue: String
  - newValue: String
  - ipAddress: String
  - createdAt: LocalDateTime
}

' --------------------------------------------------------------------
' 6. QUAN HỆ GIỮA CÁC TẦNG (Dependencies & Realizations)
' --------------------------------------------------------------------
AccountController ..> AccountService : <<access>>
RoleController ..> RoleService : <<access>>
AuditLogController ..> AuditLogService : <<access>>

AccountServiceImpl ..|> AccountService
RoleServiceImpl ..|> RoleService
AuditLogServiceImpl ..|> AuditLogService

AccountServiceImpl ..> AccountRepository
AccountServiceImpl ..> AccountInformationRepository
AccountServiceImpl ..> RoleRepository
AccountServiceImpl ..> RolePermissionRepository

RoleServiceImpl ..> RoleRepository
RoleServiceImpl ..> RolePermissionRepository

AuditLogServiceImpl ..> AuditLogRepository
AuditLogServiceImpl ..> AccountRepository

AccountRepository ..> Account
AccountInformationRepository ..> AccountInformation
RoleRepository ..> Role
RolePermissionRepository ..> RolePermission
AuditLogRepository ..> AuditLog

Account ..> AccountStatus : <<uses>>

' DTO Dependencies
AccountController ..> AccountCreateRequest : <<uses>>
AccountController ..> AccountUpdateRequest : <<uses>>
AccountController ..> RoleAssignRequest : <<uses>>
AccountController ..> AccountResponse : <<uses>>
AccountController ..> AccountDetailResponse : <<uses>>

RoleController ..> RoleDto : <<uses>>
RoleController ..> PermissionDto : <<uses>>

AuditLogController ..> AuditLogResponse : <<uses>>

' --------------------------------------------------------------------
' 7. QUAN HỆ GIỮA CÁC ENTITY (COMET Associations & Multiplicities)
' --------------------------------------------------------------------
Account "1" *-- "0..1" AccountInformation : has profile >
Role "0..1" <-- "0..*" Account : assigned to <
Role "1" *-- "0..*" RolePermission : has >
Permission "1" <-- "0..*" RolePermission : grants <
RolePermission *-- "1" RolePermissionId : key >
Account "0..1" <-- "0..*" AuditLog : logs actions of <

@enduml
