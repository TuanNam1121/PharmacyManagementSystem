@startuml
' --- VISUAL PARADIGM STYLE CONFIGURATION ---
skinparam Style strictuml
skinparam SequenceMessageAlignment left
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' Cấu hình Participant: Màu nền xanh nhạt, chữ đen, không in đậm
skinparam Participant {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
    Padding 5
}

skinparam Actor {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Database {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Sequence {
    ' Tô màu xanh cho các thanh kích hoạt (activation boxes)
    LifeLineBackgroundColor #A0D8EF
    LifeLineBorderColor #000000

    ArrowColor #000000
    ArrowFontColor #000000
    ArrowFontSize 11

    BoxBackgroundColor #A0D8EF
    BoxBorderColor #000000
    BoxFontColor #000000
}

skinparam Note {
    BackgroundColor #FFF9E6
    BorderColor #000000
    FontColor #000000
}

skinparam LifeLineStrategy solid

' --- ACTORS & PARTICIPANTS ---
actor "Admin" as Admin
participant "<<boundary>>\nCategoryPage" as CategoryPage
participant "<<boundary>>\nCategoryFormModal" as CategoryFormModal
participant "<<control>>\nCategoryController" as CategoryController
participant "<<control>>\nCategoryService" as CategoryService
participant "Database" as Database

' --- STEP 1 & 2: SELECT CATEGORY & OPEN EDIT MODAL ---
Admin -> CategoryPage : 1: Click "Edit" action button on category row
activate CategoryPage

CategoryPage -> CategoryFormModal : 2: Open "Edit Category" modal pre-filled with selected row data
deactivate CategoryPage
activate CategoryFormModal

CategoryFormModal --> Admin : 3: Display Edit modal (Category Name, Description)

' --- STEP 3: SUBMIT OR CANCEL ---
alt Admin cancels edit (AT02)
    Admin -> CategoryFormModal : 4: Click "Cancel" button
    CategoryFormModal -> CategoryPage : 5: Close modal and discard uncommitted changes
    deactivate CategoryFormModal
    activate CategoryPage
    CategoryPage --> Admin : 6: Return to category directory view
    deactivate CategoryPage

else Admin updates fields and submits
    Admin -> CategoryFormModal : 7: Update Name or Description and click "Save Changes"
    activate CategoryFormModal

    CategoryFormModal -> CategoryFormModal : 8: Check validation on client-side

    alt Validation failure / name is empty (AT01)
        CategoryFormModal --> Admin : 9: Display error "Category name cannot be empty"
    else Validation passed on UI
        CategoryFormModal -> CategoryController : 10: updateCategory(categoryId, CategoryUpdateRequest)
        activate CategoryController

        CategoryController -> CategoryService : 11: updateCategory(categoryId, request)
        activate CategoryService

        CategoryService -> Database : 12: Query Category by ID and check uniqueness of modified name
        activate Database

        alt Duplicate Category Name found on another category
            Database --> CategoryService : 13: Name conflict detected
            deactivate Database

            CategoryService --> CategoryController : 14: Throw DuplicateResourceException("Category name already exists")
            deactivate CategoryService

            CategoryController --> CategoryFormModal : 15: Return 400 Bad Request
            deactivate CategoryController

            CategoryFormModal --> Admin : 16: Display error alert "Category name is already in use"
        else Validation & uniqueness verified
            Database --> CategoryService : 17: Category found & name verified
            activate Database

            CategoryService -> Database : 18: Update Category entity in categories table
            Database --> CategoryService : 19: Category record updated successfully

            CategoryService -> Database : 20: Insert System Audit Log entry (Action=UPDATE_CATEGORY)
            Database --> CategoryService : 21: Audit entry persisted
            deactivate Database

            CategoryService --> CategoryController : 22: Return updated CategoryResponse DTO
            activate CategoryService
            deactivate CategoryService

            CategoryController --> CategoryFormModal : 23: Return 200 OK with updated category
            activate CategoryController
            deactivate CategoryController

            CategoryFormModal -> CategoryPage : 24: Close modal and refresh categories list
            deactivate CategoryFormModal
            activate CategoryPage

            CategoryPage --> Admin : 25: Display success alert "Category updated successfully" and refresh table
            deactivate CategoryPage
        end
    end
end

@enduml