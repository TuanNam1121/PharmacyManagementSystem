@startuml
' --- VISUAL PARADIGM STYLE CONFIGURATION (BLUE ACTIVATION BOXES) ---
skinparam Style strictuml
skinparam SequenceMessageAlignment left
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' Cấu hình Participant: Màu nền xanh nhạt, chữ đen, không in đậm
skinparam Participant {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
    Padding 5
}

skinparam Actor {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Database {
    BackgroundColor #A0D8EF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    FontStyle plain
}

skinparam Sequence {
    ' Tô màu xanh cho các thanh kích hoạt (activation boxes) và đường đời
    LifeLineBackgroundColor #A0D8EF
    LifeLineBorderColor #000000

    ArrowColor #000000
    ArrowFontColor #000000
    ArrowFontSize 11

    BoxBackgroundColor #A0D8EF
    BoxBorderColor #000000
    BoxFontColor #000000
}

skinparam Note {
    BackgroundColor #FFF9E6
    BorderColor #000000
    FontColor #000000
}

skinparam LifeLineStrategy solid

' --- ACTORS & PARTICIPANTS ---
actor "Admin" as Admin
participant "<<boundary>>\nHomepage" as Homepage
participant "<<boundary>>\nCategoryPage" as CategoryPage
participant "<<control>>\nCategoryController" as CategoryController
participant "<<control>>\nCategoryService" as CategoryService
participant "Database" as Database

' --- STEP 1 & 2: ACCESS CATEGORIES PAGE ---
Admin -> Homepage : 1: Select "Category Management" from main menu
activate Homepage

Homepage -> CategoryPage : 2: Navigate to CategoryPage
deactivate Homepage
activate CategoryPage

CategoryPage -> CategoryController : 3: getAllCategories()
activate CategoryController

CategoryController -> CategoryService : 4: getCategories()
activate CategoryService

CategoryService -> Database : 5: Query categories sorted by name / display order
activate Database

' --- STEP 2 DATA RETURN ---
alt No categories exist in database
    Database --> CategoryService : 6: Return empty list
    deactivate Database

    CategoryService --> CategoryController : 7: Return empty List<CategoryResponse>
    deactivate CategoryService

    CategoryController --> CategoryPage : 8: Return 200 OK (empty list)
    deactivate CategoryController

    CategoryPage --> Admin : 9: Display message "No categories found"
else Categories found
    Database --> CategoryService : 10: Return categories entities list
    activate Database
    deactivate Database

    CategoryService --> CategoryController : 11: Return List<CategoryResponse>
    activate CategoryService
    deactivate CategoryService

    CategoryController --> CategoryPage : 12: Return 200 OK with categories data
    activate CategoryController
    deactivate CategoryController

    CategoryPage --> Admin : 13: Render category directory table with search and filter controls

    ' --- STEP 3, 4, 5: SEARCH / FILTER CATEGORIES ---
    Admin -> CategoryPage : 14: Enter search keyword or filter by status (ACTIVE / INACTIVE)

    CategoryPage -> CategoryPage : 15: Apply client-side filter on categories list

    alt No matching category found (AT01)
        CategoryPage --> Admin : 16: Display informational message "No matching categories found"
    else Matching categories found
        CategoryPage --> Admin : 17: Update table with matching category rows
    end

    ' --- RESET / CANCEL SEARCH (AT02) ---
    alt Admin clears filter
        Admin -> CategoryPage : 18: Click "Clear Filters"
        CategoryPage --> Admin : 19: Reset filter inputs and display full category directory
    end
end

deactivate CategoryPage

@enduml