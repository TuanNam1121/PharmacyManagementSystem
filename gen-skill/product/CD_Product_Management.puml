@startuml
skinparam classAttributeIconSize 0
skinparam style strictuml
hide empty members

' ====================================================================
' MODULE PRODUCT MANAGEMENT CLASS DIAGRAM (COMET METHOD)
' ====================================================================

' --------------------------------------------------------------------
' 1. TẦNG CONTROLLER (<<control>>)
' --------------------------------------------------------------------
class ProductController <<control>> {
  - productService: ProductService
  + createProduct(request: ProductCreateRequest): ResponseEntity<ApiResponse<ProductResponse>>
  + updateProduct(id: Long, request: ProductUpdateRequest): ResponseEntity<ApiResponse<ProductResponse>>
  + updateProductPrice(id: Long, request: ProductPriceUpdateRequest): ResponseEntity<ApiResponse<ProductResponse>>
  + getProductDetail(id: Long): ResponseEntity<ApiResponse<ProductDetailResponse>>
  + getProducts(keyword: String, status: Short, categoryId: Integer, page: int, size: int, sortBy: String, sortDir: String): ResponseEntity<ApiResponse<PageResponse<ProductResponse>>>
  + updateProductStatus(id: Long, status: Short): ResponseEntity<ApiResponse<Void>>
  + getPriceHistories(id: Long): ResponseEntity<ApiResponse<List<PriceHistoryResponse>>>
}

' --------------------------------------------------------------------
' 2. TẦNG SERVICE (<<interface>> & <<control>> Impl)
' --------------------------------------------------------------------
interface ProductService <<interface>> {
  + createProduct(request: ProductCreateRequest): ProductResponse
  + updateProduct(id: Long, request: ProductUpdateRequest): ProductResponse
  + updateProductPrice(id: Long, request: ProductPriceUpdateRequest): ProductResponse
  + getProductDetail(id: Long): ProductDetailResponse
  + updateProductStatus(id: Long, status: Short): void
  + getProducts(keyword: String, status: Short, categoryId: Integer, page: int, size: int, sortBy: String, sortDir: String): PageResponse<ProductResponse>
  + getPriceHistories(productId: Long): List<PriceHistoryResponse>
}

class ProductServiceImpl <<control>> {
  - productRepository: ProductRepository
  - categoryRepository: CategoryRepository
  - priceHistoryRepository: PriceHistoryRepository
  - productBatchRepository: ProductBatchRepository
  - accountRepository: AccountRepository
  + createProduct(request: ProductCreateRequest): ProductResponse
  + updateProduct(id: Long, request: ProductUpdateRequest): ProductResponse
  + updateProductPrice(id: Long, request: ProductPriceUpdateRequest): ProductResponse
  + getProductDetail(id: Long): ProductDetailResponse
  + updateProductStatus(id: Long, status: Short): void
  + getProducts(keyword: String, status: Short, categoryId: Integer, page: int, size: int, sortBy: String, sortDir: String): PageResponse<ProductResponse>
  + getPriceHistories(productId: Long): List<PriceHistoryResponse>
  - mapToProductResponse(product: Product): ProductResponse
  - mapToPriceHistoryResponse(history: PriceHistory): PriceHistoryResponse
  - getCurrentAccount(): Account
}

' --------------------------------------------------------------------
' 3. TẦNG REPOSITORY (<<interface>>)
' --------------------------------------------------------------------
interface ProductRepository <<interface>> {
  + existsByBarcode(barcode: String): boolean
  + existsByBarcodeAndIdNot(barcode: String, id: Long): boolean
  + existsByCategoryIdAndStatus(categoryId: Long, status: ProductStatus): boolean
  + findByIdWithCategory(id: Long): Optional<Product>
  + findProductsWithFilters(keyword: String, status: ProductStatus, categoryId: Long, pageable: Pageable): Page<Product>
  + save(product: Product): Product
  + findById(id: Long): Optional<Product>
}

interface PriceHistoryRepository <<interface>> {
  + findByProductIdWithAccount(productId: Long): List<PriceHistory>
  + findByProductIdOrderByEffectiveFromDesc(productId: Long): List<PriceHistory>
  + save(priceHistory: PriceHistory): PriceHistory
}

interface ProductBatchRepository <<interface>> {
  + findByProductId(productId: Long): List<ProductBatch>
  + findByBatchNumber(batchNumber: String): Optional<ProductBatch>
  + save(productBatch: ProductBatch): ProductBatch
  + findById(id: Long): Optional<ProductBatch>
}

interface CategoryRepository <<interface>> {
  + findById(id: Long): Optional<Category>
}

interface AccountRepository <<interface>> {
  + findByUsername(username: String): Optional<Account>
  + findAll(): List<Account>
}

' --------------------------------------------------------------------
' 4. TẦNG ENTITY & ENUM (<<entity>>, <<enum>>)
' --------------------------------------------------------------------
class Product <<entity>> {
  - id: Long
  - barcode: String
  - name: String
  - unit: String
  - activeIngredient: String
  - manufacturer: String
  - isPrescription: Boolean
  - costPrice: BigDecimal
  - sellingPrice: BigDecimal
  - minQuantity: Integer
  - description: String
  - imageUrl: String
  - status: ProductStatus
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
  - category: Category
}

class PriceHistory <<entity>> {
  - id: Long
  - product: Product
  - account: Account
  - costPrice: BigDecimal
  - sellingPrice: BigDecimal
  - effectiveFrom: LocalDateTime
  - reason: String
  - createdAt: LocalDateTime
}

class ProductBatch <<entity>> {
  - id: Long
  - product: Product
  - batchNumber: String
  - manufactureDate: LocalDate
  - expiryDate: LocalDate
  - supplier: Supplier
  - createdAt: LocalDateTime
}

enum ProductStatus <<enum>> {
  + ACTIVE : 1
  + INACTIVE : 0
  + DISCONTINUED : 2
  - code: Short
  - label: String
  + getCode(): Short
  + getLabel(): String
  + fromCode(code: Short): ProductStatus
}

class Category <<entity>> {
  - id: Long
  - name: String
}

class Account <<entity>> {
  - id: Long
  - username: String
}

class Supplier <<entity>> {
  - id: Long
  - code: String
  - name: String
}

' --------------------------------------------------------------------
' 5. TẦNG DTO (Data Transfer Objects)
' --------------------------------------------------------------------
class ProductCreateRequest <<dto>> {
  - categoryId: Long
  - barcode: String
  - name: String
  - unit: String
  - activeIngredient: String
  - manufacturer: String
  - isPrescription: Boolean
  - costPrice: BigDecimal
  - sellingPrice: BigDecimal
  - minQuantity: Integer
  - description: String
  - imageUrl: String
  - status: Short
  - priceReason: String
}

class ProductUpdateRequest <<dto>> {
  - categoryId: Long
  - barcode: String
  - name: String
  - unit: String
  - activeIngredient: String
  - manufacturer: String
  - isPrescription: Boolean
  - costPrice: BigDecimal
  - sellingPrice: BigDecimal
  - minQuantity: Integer
  - description: String
  - imageUrl: String
  - status: Short
  - priceReason: String
}

class ProductPriceUpdateRequest <<dto>> {
  - costPrice: BigDecimal
  - sellingPrice: BigDecimal
  - effectiveFrom: LocalDateTime
  - reason: String
}

class ProductResponse <<dto>> {
  - id: Long
  - barcode: String
  - name: String
  - unit: String
  - sellingPrice: BigDecimal
  - costPrice: BigDecimal
  - status: Short
  - statusLabel: String
  - imageUrl: String
  - categoryId: Long
  - categoryName: String
}

class ProductDetailResponse <<dto>> {
  - id: Long
  - barcode: String
  - name: String
  - unit: String
  - activeIngredient: String
  - manufacturer: String
  - isPrescription: Boolean
  - costPrice: BigDecimal
  - sellingPrice: BigDecimal
  - minQuantity: Integer
  - description: String
  - imageUrl: String
  - status: Short
  - statusLabel: String
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
  - categoryId: Long
  - categoryName: String
}

class PriceHistoryResponse <<dto>> {
  - id: Long
  - productId: Long
  - productName: String
  - accountId: Long
  - accountUsername: String
  - accountFullName: String
  - costPrice: BigDecimal
  - sellingPrice: BigDecimal
  - effectiveFrom: LocalDateTime
  - reason: String
  - createdAt: LocalDateTime
}

' --------------------------------------------------------------------
' 6. QUAN HỆ GIỮA CÁC TẦNG (Dependencies & Realizations)
' --------------------------------------------------------------------
ProductController ..> ProductService : <<access>>
ProductServiceImpl ..|> ProductService

ProductServiceImpl ..> ProductRepository
ProductServiceImpl ..> PriceHistoryRepository
ProductServiceImpl ..> ProductBatchRepository
ProductServiceImpl ..> CategoryRepository
ProductServiceImpl ..> AccountRepository

ProductRepository ..> Product
PriceHistoryRepository ..> PriceHistory
ProductBatchRepository ..> ProductBatch

Product ..> ProductStatus : <<uses>>

' DTO Dependencies
ProductController ..> ProductCreateRequest : <<uses>>
ProductController ..> ProductUpdateRequest : <<uses>>
ProductController ..> ProductPriceUpdateRequest : <<uses>>
ProductController ..> ProductResponse : <<uses>>
ProductController ..> ProductDetailResponse : <<uses>>
ProductController ..> PriceHistoryResponse : <<uses>>

' --------------------------------------------------------------------
' 7. QUAN HỆ GIỮA CÁC ENTITY (COMET Associations & Multiplicities)
' --------------------------------------------------------------------
' Bảng giá sản phẩm (Composition: Lịch sử giá gắn liền vòng đời sản phẩm)
Product "1" *-- "0..*" PriceHistory : maintains pricing >

' Biến thể / Lô sản phẩm (Composition: Lô / biến thể sản phẩm gắn liền sản phẩm)
Product "1" *-- "0..*" ProductBatch : variants / batches >

' Phân loại danh mục
Category "1" <-- "0..*" Product : classified under <

' Người thực hiện thay đổi giá
Account "1" <-- "0..*" PriceHistory : recorded by <

' Nhà cung cấp của lô hàng / biến thể
Supplier "0..1" <-- "0..*" ProductBatch : supplied by <

@enduml
