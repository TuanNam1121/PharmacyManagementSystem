@startuml SQ14_Process_Payment
title UC24 - Process Payment Sequence Diagram
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "Pharmacist" as Pharmacist #7ACFF5
actor "Customer" as Customer #7ACFF5
participant "<<boundary>>\nPaymentModal" as PaymentModal #7ACFF5
participant "<<control>>\nPaymentController" as PaymentController #7ACFF5
participant "<<control>>\nPayOSPaymentServiceImpl" as PaymentService #7ACFF5
participant "<<boundary>>\nPayOS Gateway (VietQR)" as PayOSGateway #7ACFF5
participant "<<entity>>\nPaymentRepository" as PaymentRepository #7ACFF5
participant "<<entity>>\nSalesInvoiceRepository" as InvoiceRepository #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate Pharmacist #7ACFF5
Pharmacist -> PaymentModal: Open payment dialog, select payment method
activate PaymentModal #7ACFF5

alt Option 1: Cash Payment (CASH)
    Pharmacist -> PaymentModal: Input customer given cash (e.g. 200,000 VND)
    PaymentModal -> PaymentModal: Calculate change = 200,000 - 154,000 = 46,000 VND
    Pharmacist -> PaymentModal: Click "Xác nhận thanh toán (F10)"
    
    PaymentModal -> PaymentController: POST /api/v1/payments (PaymentRequest: method=1, amount=154000)
    activate PaymentController #7ACFF5
    PaymentController -> PaymentRepository: save(Payment: method=1, status=1, amount=154000)
    activate PaymentRepository #7ACFF5
    PaymentRepository -> DB: INSERT INTO payments (...)
    activate DB #7ACFF5
    DB --> PaymentRepository: OK
    deactivate DB
    PaymentRepository --> PaymentController: Payment entity
    deactivate PaymentRepository
    
    PaymentController --> PaymentModal: HTTP 200 OK
    deactivate PaymentController
    PaymentModal --> Pharmacist: Open cash drawer, trigger receipt printing

else Option 2: VietQR Online Transfer (PayOS)
    PaymentModal -> PaymentController: POST /api/v1/payments/payos/create-payment-link
    activate PaymentController #7ACFF5
    PaymentController -> PaymentService: createPaymentLink(request)
    activate PaymentService #7ACFF5
    
    PaymentService -> PayOSGateway: createPaymentLink(PaymentData: orderCode, amount)
    activate PayOSGateway #7ACFF5
    PayOSGateway --> PaymentService: CheckoutResponseData (qrCode, paymentLinkId)
    deactivate PayOSGateway
    
    PaymentService --> PaymentController: PayOSPaymentResponse (qrCodeUrl, orderCode)
    deactivate PaymentService
    
    PaymentController --> PaymentModal: HTTP 200 OK + qrCodeUrl
    deactivate PaymentController
    
    PaymentModal --> Customer: Display dynamic VietQR on screen with 15-minute countdown
    activate Customer #7ACFF5
    Customer -> PayOSGateway: Scan QR with Mobile Banking and approve payment
    deactivate Customer
    
    PayOSGateway -> PaymentController: POST /api/v1/payments/payos/webhook (WebhookRequest + Checksum)
    activate PaymentController #7ACFF5
    PaymentController -> PaymentService: processWebhook(WebhookRequest)
    activate PaymentService #7ACFF5
    
    PaymentService -> PaymentService: verifyChecksum(data, signature, CHECKSUM_KEY)
    activate PaymentService #7ACFF5
    deactivate PaymentService
    
    alt Valid Checksum Signature
        PaymentService -> PaymentRepository: save(Payment: method=2, status=1, code=orderCode)
        activate PaymentRepository #7ACFF5
        PaymentRepository -> DB: INSERT INTO payments (...)
        activate DB #7ACFF5
        DB --> PaymentRepository: OK
        deactivate DB
        PaymentRepository --> PaymentService: OK
        deactivate PaymentRepository
        
        PaymentService -> InvoiceRepository: updateStatus(invoiceId, status=1 - PAID)
        activate InvoiceRepository #7ACFF5
        InvoiceRepository -> DB: UPDATE sales_invoices SET status=1 WHERE id=?
        activate DB #7ACFF5
        DB --> InvoiceRepository: OK
        deactivate DB
        InvoiceRepository --> PaymentService: OK
        deactivate InvoiceRepository
        
        PaymentService --> PaymentController: OK
        deactivate PaymentService
        PaymentController --> PayOSGateway: HTTP 200 OK (Webhook confirmed)
        deactivate PaymentController
        
        PaymentModal -> PaymentModal: Real-time event: Payment Successful
        PaymentModal --> Pharmacist: Auto-close modal, trigger K80 invoice print
    else Tampered Signature
        PaymentService --> PaymentController: throw InvalidSignatureException
        PaymentController --> PayOSGateway: HTTP 400 Bad Request
    end
end

deactivate PaymentModal
deactivate Pharmacist
@enduml