@startuml SQ14_Process_Payment
title UC22 - Process Payment Sequence Diagram (Code-based Flow)
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "Pharmacist" as Pharmacist #7ACFF5
actor "Customer" as Customer #7ACFF5
participant "<<boundary>>\nPaymentModal.jsx" as PaymentModal #7ACFF5
participant "<<control>>\npaymentApi.js" as PaymentApi #7ACFF5
participant "<<control>>\nPaymentController" as PaymentController #7ACFF5
participant "<<control>>\nPayOSPaymentServiceImpl" as PaymentService #7ACFF5
participant "<<boundary>>\nPayOS VietQR Gateway" as PayOSGateway #7ACFF5
participant "<<entity>>\nPaymentRepository" as PaymentRepository #7ACFF5
participant "<<entity>>\nSalesInvoiceRepository" as InvoiceRepository #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate Pharmacist #7ACFF5
Pharmacist -> PaymentModal: Select payment method tab
activate PaymentModal #7ACFF5

alt Method 1: Cash Payment (Tiền mặt - CASH)
    Pharmacist -> PaymentModal: Enter tenderedCash (e.g. 200,000 VND)
    PaymentModal -> PaymentModal: Calculate changeAmount = 200,000 - 154,000 = 46,000 VND
    Pharmacist -> PaymentModal: Click "Xác nhận thanh toán (F10)"
    PaymentModal --> Pharmacist: Pass payment details { method: 1, tenderedCash, changeAmount } to checkout flow

else Method 2: Dynamic VietQR Online Transfer (PayOS)
    PaymentModal -> PaymentApi: createPayOSLink({ amount, description })
    activate PaymentApi #7ACFF5

    PaymentApi -> PaymentController: POST /api/v1/sales/payments/payos/create-link (CreatePayOSPaymentRequest)
    activate PaymentController #7ACFF5

    PaymentController -> PaymentService: createPaymentLink(CreatePayOSPaymentRequest)
    activate PaymentService #7ACFF5

    PaymentService -> PayOSGateway: createPaymentLink(PaymentData: orderCode, amount, returnUrl, cancelUrl)
    activate PayOSGateway #7ACFF5
    PayOSGateway --> PaymentService: CheckoutResponseData (qrCode, paymentLinkId, accountNumber)
    deactivate PayOSGateway

    PaymentService --> PaymentController: PayOSPaymentResponse (orderCode, qrCodeUrl, amount)
    deactivate PaymentService

    PaymentController --> PaymentApi: HTTP 200 OK + ApiResponse.success(response)
    deactivate PaymentController

    PaymentApi --> PaymentModal: PayOSPaymentResponse
    deactivate PaymentApi

    PaymentModal --> Customer: Display dynamic VietQR image with countdown timer (15 mins)
    activate Customer #7ACFF5
    Customer -> PayOSGateway: Scan VietQR with Mobile Banking app & approve transfer
    deactivate Customer

    == PayOS Webhook Notification ==
    PayOSGateway -> PaymentController: POST /api/v1/sales/payments/payos/webhook (PayOSWebhookRequest + Signature)
    activate PaymentController #7ACFF5

    PaymentController -> PaymentService: handleWebhook(PayOSWebhookRequest)
    activate PaymentService #7ACFF5

    PaymentService -> PaymentService: verifySignature(webhookData, CHECKSUM_KEY)
    activate PaymentService #7ACFF5
    deactivate PaymentService

    alt Valid Checksum Signature
        PaymentService -> PaymentRepository: save(Payment: method=3, amount, status=1, transactionCode=orderCode)
        activate PaymentRepository #7ACFF5
        PaymentRepository -> DB: INSERT INTO payments (payment_method=3, status=1, ...)
        activate DB #7ACFF5
        DB --> PaymentRepository: OK
        deactivate DB
        PaymentRepository --> PaymentService: OK
        deactivate PaymentRepository

        PaymentService -> InvoiceRepository: updateStatus(invoiceId, status=1 - PAID)
        activate InvoiceRepository #7ACFF5
        InvoiceRepository -> DB: UPDATE sales_invoices SET status=1, paid_at=NOW() WHERE id=?
        activate DB #7ACFF5
        DB --> InvoiceRepository: OK
        deactivate DB
        InvoiceRepository --> PaymentService: OK
        deactivate InvoiceRepository

        PaymentService --> PaymentController: boolean (true)
        deactivate PaymentService

        PaymentController --> PayOSGateway: HTTP 200 OK { code: "00", desc: "success" }
        deactivate PaymentController

        == Real-time Frontend Polling ==
        PaymentModal -> PaymentApi: checkPayOSStatus(orderCode)
        activate PaymentApi #7ACFF5
        PaymentApi -> PaymentController: GET /api/v1/sales/payments/payos/status/{orderCode}
        activate PaymentController #7ACFF5
        PaymentController --> PaymentApi: HTTP 200 OK (status: "PAID")
        deactivate PaymentController
        PaymentApi --> PaymentModal: Status PAID
        deactivate PaymentApi

        PaymentModal -> PaymentModal: Trigger onPaymentSuccess()
        PaymentModal --> Pharmacist: Close payment modal, trigger print template
    else Invalid Signature
        PaymentService --> PaymentController: false
        PaymentController --> PayOSGateway: HTTP 400 Bad Request
    end
end

deactivate PaymentModal
deactivate Pharmacist
@enduml