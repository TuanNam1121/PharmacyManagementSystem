@startuml SQ15_Cancel_Return_Sales_Invoice
title UC25 - Cancel / Return Sales Invoice Sequence Diagram (Code-based Flow)
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "Pharmacist" as Pharmacist #7ACFF5
participant "<<boundary>>\nDailySalesPage.jsx" as DailySalesPage #7ACFF5
participant "<<boundary>>\nSalesReturnModal.jsx" as ReturnModal #7ACFF5
participant "<<control>>\nsalesApi.js" as SalesApi #7ACFF5
participant "<<control>>\nSalesInvoiceController" as InvoiceController #7ACFF5
participant "<<control>>\nSalesInvoiceServiceImpl" as InvoiceServiceImpl #7ACFF5
participant "<<entity>>\nSalesInvoiceRepository" as InvoiceRepository #7ACFF5
participant "<<entity>>\nSalesReturnRepository" as ReturnRepository #7ACFF5
participant "<<entity>>\nInventoryRepository" as InventoryRepository #7ACFF5
participant "<<entity>>\nSalesReturnDetailRepository" as ReturnDetailRepo #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate Pharmacist #7ACFF5
Pharmacist -> DailySalesPage: Click "Trả hàng" button on daily invoice row
activate DailySalesPage #7ACFF5

DailySalesPage -> ReturnModal: Open modal directly with invoiceId (no code prompt modal needed)
activate ReturnModal #7ACFF5

ReturnModal -> SalesApi: getInvoiceById(invoiceId)
activate SalesApi #7ACFF5

SalesApi -> InvoiceController: GET /api/v1/sales/invoices/{codeOrId} (Bearer AT)
activate InvoiceController #7ACFF5

InvoiceController -> InvoiceServiceImpl: getInvoiceById(invoiceId)
activate InvoiceServiceImpl #7ACFF5
InvoiceServiceImpl --> InvoiceController: SalesInvoiceResponse (items, batches, units, prices)
deactivate InvoiceServiceImpl

InvoiceController --> SalesApi: HTTP 200 OK + ApiResponse.success(response)
deactivate InvoiceController

SalesApi --> ReturnModal: SalesInvoiceResponse
deactivate SalesApi

ReturnModal --> Pharmacist: Render invoice line items pre-filled with purchased quantities

Pharmacist -> ReturnModal: Select items to return, adjust return quantities, select refundMethod (Cash/Bank), input reason
Pharmacist -> ReturnModal: Click "Xác nhận Trả Hàng"

ReturnModal -> SalesApi: returnSalesInvoice(SalesReturnRequest)
activate SalesApi #7ACFF5

SalesApi -> InvoiceController: POST /api/v1/sales/invoices/return (SalesReturnRequest, Bearer AT)
activate InvoiceController #7ACFF5

InvoiceController -> InvoiceServiceImpl: returnSalesInvoice(SalesReturnRequest, accountId)
activate InvoiceServiceImpl #7ACFF5

InvoiceServiceImpl -> InvoiceRepository: findById(request.getInvoiceId())
activate InvoiceRepository #7ACFF5
InvoiceRepository --> InvoiceServiceImpl: SalesInvoice entity
deactivate InvoiceRepository

InvoiceServiceImpl -> InvoiceServiceImpl: Calculate totalRefundAmount = SUM(item.returnQty * unitPrice)
InvoiceServiceImpl -> InvoiceServiceImpl: isFullReturn = (totalRefundAmount >= invoice.finalAmount)
InvoiceServiceImpl -> InvoiceServiceImpl: returnType = isFullReturn ? 1 : 2 (1=FULL, 2=PARTIAL)
InvoiceServiceImpl -> InvoiceServiceImpl: generateReturnCode() -> 'RET-20261108-0001'

InvoiceServiceImpl -> ReturnRepository: save(SalesReturn: code, returnType, refundAmount, invoice, shift, reason)
activate ReturnRepository #7ACFF5
ReturnRepository -> DB: INSERT INTO sales_returns (code, return_type, refund_amount, sales_invoice_id, shift_id, ...)
activate DB #7ACFF5
DB --> ReturnRepository: SalesReturn entity (non-null return_type constraint satisfied)
deactivate DB
ReturnRepository --> InvoiceServiceImpl: savedReturn
deactivate ReturnRepository

loop For each returned medicine item (Restock branch inventory)
    InvoiceServiceImpl -> InventoryRepository: findByStoreIdAndProductIdAndBatchId(storeId, productId, batchId)
    activate InventoryRepository #7ACFF5
    InventoryRepository -> DB: SELECT * FROM inventories WHERE store_id=? AND product_id=? AND batch_id=?
    activate DB #7ACFF5
    DB --> InventoryRepository: Inventory entity
    deactivate DB

    InvoiceServiceImpl -> InventoryRepository: inv.setQuantity(inv.quantity + baseQtyToReturn)
    InventoryRepository -> DB: UPDATE inventories SET quantity=?, updated_at=NOW() WHERE id=?
    activate DB #7ACFF5
    DB --> InventoryRepository: OK
    deactivate DB
    InventoryRepository --> InvoiceServiceImpl: OK
    deactivate InventoryRepository

    InvoiceServiceImpl -> ReturnDetailRepo: save(SalesReturnDetail: returnId, productId, quantity, refundAmount)
    activate ReturnDetailRepo #7ACFF5
    ReturnDetailRepo -> DB: INSERT INTO sales_return_details (...)
    activate DB #7ACFF5
    DB --> ReturnDetailRepo: OK
    deactivate DB
    ReturnDetailRepo --> InvoiceServiceImpl: OK
    deactivate ReturnDetailRepo
end

InvoiceServiceImpl -> InvoiceRepository: invoice.setStatus(isFullReturn ? 4 : 3) -- 4=FULLY_RETURNED, 3=PARTIALLY_RETURNED
activate InvoiceRepository #7ACFF5
InvoiceRepository -> DB: UPDATE sales_invoices SET status=?, cancel_reason=? WHERE id=?
activate DB #7ACFF5
DB --> InvoiceRepository: OK
deactivate DB
InvoiceRepository --> InvoiceServiceImpl: OK
deactivate InvoiceRepository

InvoiceServiceImpl --> InvoiceController: SalesReturnResponse (returnCode, refundAmount, returnType)
deactivate InvoiceServiceImpl

InvoiceController --> SalesApi: HTTP 200 OK + ApiResponse.success(response)
deactivate InvoiceController

SalesApi --> ReturnModal: SalesReturnResponse
deactivate SalesApi

ReturnModal -> DailySalesPage: Close modal, refresh daily invoices table
deactivate ReturnModal

DailySalesPage --> Pharmacist: Show Toast "Hoàn trả hàng thành công!", update row status
deactivate DailySalesPage
deactivate Pharmacist
@enduml