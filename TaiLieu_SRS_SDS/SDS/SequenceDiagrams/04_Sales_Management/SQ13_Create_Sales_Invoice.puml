@startuml SQ13_Create_Sales_Invoice
title UC21 - Create Sales Invoice Sequence Diagram (Code-based Flow)
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "Pharmacist" as Pharmacist #7ACFF5
participant "<<boundary>>\nPosCounterPage.jsx" as PosCounterPage #7ACFF5
participant "<<boundary>>\nCustomerSelectModal.jsx" as CustomerSelectModal #7ACFF5
participant "<<boundary>>\nCustomerFormModal.jsx" as CustomerFormModal #7ACFF5
participant "<<boundary>>\nPaymentModal.jsx" as PaymentModal #7ACFF5
participant "<<boundary>>\nInvoicePrintTemplate.jsx" as PrintTemplate #7ACFF5
participant "<<control>>\nsalesApi.js" as SalesApi #7ACFF5
participant "<<control>>\nSalesInvoiceController" as InvoiceController #7ACFF5
participant "<<control>>\nSalesInvoiceServiceImpl" as InvoiceServiceImpl #7ACFF5
participant "<<entity>>\nShiftRepository" as ShiftRepository #7ACFF5
participant "<<entity>>\nCustomerRepository" as CustomerRepository #7ACFF5
participant "<<entity>>\nProductRepository" as ProductRepository #7ACFF5
participant "<<entity>>\nProductBatchRepository" as BatchRepository #7ACFF5
participant "<<entity>>\nInventoryRepository" as InventoryRepository #7ACFF5
participant "<<entity>>\nSalesInvoiceRepository" as InvoiceRepository #7ACFF5
participant "<<entity>>\nPaymentRepository" as PaymentRepository #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate Pharmacist #7ACFF5
Pharmacist -> PosCounterPage: Scan barcodes / search medicine, pick units (Viên/Vỉ/Hộp)
activate PosCounterPage #7ACFF5

== Customer Identification (Mandatory) ==
opt Customer not yet selected (customer == null)
    Pharmacist -> PosCounterPage: Click "+ Nhập SĐT"
    PosCounterPage -> CustomerSelectModal: Open modal (search by phone/name)
    activate CustomerSelectModal #7ACFF5

    alt Customer not in system
        Pharmacist -> CustomerSelectModal: Click "+ Thêm Mới"
        CustomerSelectModal -> CustomerFormModal: Open modal on top
        activate CustomerFormModal #7ACFF5
        Pharmacist -> CustomerFormModal: Input fullName, phone, allergy notes, click "Lưu"
        CustomerFormModal --> PosCounterPage: Return created customer object
        deactivate CustomerFormModal
    else Customer exists
        Pharmacist -> CustomerSelectModal: Click "Chọn" on customer record
        CustomerSelectModal --> PosCounterPage: Set active customer
    end
    deactivate CustomerSelectModal
end

PosCounterPage -> PosCounterPage: Check drug ingredients against customer allergy history
opt Drug active ingredient matches allergy profile
    PosCounterPage --> Pharmacist: Render red Alert: "⚠️ Cảnh báo: Khách hàng dị ứng với hoạt chất [X]!"
end

== Payment & Invoice Creation ==
Pharmacist -> PosCounterPage: Click "Thanh toán (F9)"
PosCounterPage -> PaymentModal: Open payment dialog with subtotal & discount
activate PaymentModal #7ACFF5

Pharmacist -> PaymentModal: Select payment method (CASH / VietQR), click "Xác nhận thanh toán (F10)"
PaymentModal -> PosCounterPage: Trigger handleCompletePayment(paymentData)
deactivate PaymentModal

PosCounterPage -> SalesApi: createSalesInvoice(CreateSalesInvoiceRequest)
activate SalesApi #7ACFF5

SalesApi -> InvoiceController: POST /api/v1/sales/invoices (CreateSalesInvoiceRequest, Bearer AT)
activate InvoiceController #7ACFF5

InvoiceController -> InvoiceServiceImpl: createSalesInvoice(CreateSalesInvoiceRequest, accountId)
activate InvoiceServiceImpl #7ACFF5

InvoiceServiceImpl -> ShiftRepository: findById(shiftId)
activate ShiftRepository #7ACFF5
ShiftRepository --> InvoiceServiceImpl: Shift entity (openShift)
deactivate ShiftRepository

InvoiceServiceImpl -> CustomerRepository: findById(request.getCustomerId())
activate CustomerRepository #7ACFF5
CustomerRepository -> DB: SELECT * FROM customers WHERE id=?
activate DB #7ACFF5
DB --> CustomerRepository: Customer entity
deactivate DB
CustomerRepository --> InvoiceServiceImpl: Customer
deactivate CustomerRepository

InvoiceServiceImpl -> InvoiceServiceImpl: generateInvoiceCode() -> 'INV-20261108-3910'
activate InvoiceServiceImpl #7ACFF5
deactivate InvoiceServiceImpl

InvoiceServiceImpl -> InvoiceRepository: save(SalesInvoice: code, store, shift, customer, finalAmount, status=1)
activate InvoiceRepository #7ACFF5
InvoiceRepository -> DB: INSERT INTO sales_invoices (code, customer_id, shift_id, final_amount, status=1, ...)
activate DB #7ACFF5
DB --> InvoiceRepository: SalesInvoice entity (id=3910)
deactivate DB
InvoiceRepository --> InvoiceServiceImpl: savedInvoice
deactivate InvoiceRepository

loop For each cart line item (Deduct stock by base unit - FEFO)
    InvoiceServiceImpl -> ProductRepository: findById(item.getProductId())
    activate ProductRepository #7ACFF5
    ProductRepository --> InvoiceServiceImpl: Product entity
    deactivate ProductRepository

    InvoiceServiceImpl -> BatchRepository: findAvailableBatchesFEFO(productId, today)
    activate BatchRepository #7ACFF5
    BatchRepository -> DB: SELECT * FROM product_batches WHERE product_id=? AND expiry_date > ? ORDER BY expiry_date ASC
    activate DB #7ACFF5
    DB --> BatchRepository: List<ProductBatch> (nearest expiry first)
    deactivate DB
    BatchRepository --> InvoiceServiceImpl: ProductBatch
    deactivate BatchRepository

    InvoiceServiceImpl -> InventoryRepository: findByStoreIdAndProductIdAndBatchId(storeId, productId, batchId)
    activate InventoryRepository #7ACFF5
    InventoryRepository -> DB: SELECT * FROM inventories WHERE store_id=? AND product_id=? AND batch_id=?
    activate DB #7ACFF5
    DB --> InventoryRepository: Inventory entity
    deactivate DB

    InvoiceServiceImpl -> InventoryRepository: inv.setQuantity(inv.quantity - baseQuantityToDeduct)
    InventoryRepository -> DB: UPDATE inventories SET quantity=?, updated_at=NOW() WHERE id=?
    activate DB #7ACFF5
    DB --> InventoryRepository: OK
    deactivate DB
    InventoryRepository --> InvoiceServiceImpl: OK
    deactivate InventoryRepository
end

InvoiceServiceImpl -> PaymentRepository: save(Payment: salesInvoice, method, amount, status=1, paidAt=NOW())
activate PaymentRepository #7ACFF5
PaymentRepository -> DB: INSERT INTO payments (sales_invoice_id, payment_method, amount, status=1, ...)
activate DB #7ACFF5
DB --> PaymentRepository: OK
deactivate DB
PaymentRepository --> InvoiceServiceImpl: savedPayment
deactivate PaymentRepository

InvoiceServiceImpl --> InvoiceController: SalesInvoiceResponse
deactivate InvoiceServiceImpl

InvoiceController --> SalesApi: HTTP 201 Created + ApiResponse.success(response)
deactivate InvoiceController

SalesApi --> PosCounterPage: SalesInvoiceResponse
deactivate SalesApi

PosCounterPage -> PrintTemplate: Mount & trigger K80 print preview modal
activate PrintTemplate #7ACFF5
PrintTemplate --> Pharmacist: Display formatted receipt ready for customer handover
deactivate PrintTemplate

PosCounterPage -> PosCounterPage: clearCart(), reset customer & prescription state
PosCounterPage --> Pharmacist: Ready for new sales transaction
deactivate PosCounterPage
deactivate Pharmacist
@enduml