@startuml SQ07_Edit_Customer
title UC28 - Edit Customer Sequence Diagram (Code-based Flow)
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "Pharmacist" as Pharmacist #7ACFF5
participant "<<boundary>>\nCustomerFormModal.jsx" as CustomerFormModal #7ACFF5
participant "<<control>>\ncustomerApi.js" as CustomerApi #7ACFF5
participant "<<control>>\nCustomerController" as CustomerController #7ACFF5
participant "<<control>>\nCustomerServiceImpl" as CustomerServiceImpl #7ACFF5
participant "<<entity>>\nCustomerRepository" as CustomerRepository #7ACFF5
participant "<<entity>>\nCustomerHealthProfileRepository" as HealthProfileRepo #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate Pharmacist #7ACFF5
Pharmacist -> CustomerFormModal: Open modal in edit mode, modify fullName, phone, allergy notes, click "Lưu thay đổi"
activate CustomerFormModal #7ACFF5

CustomerFormModal -> CustomerFormModal: Validate form input
CustomerFormModal -> CustomerApi: updateCustomer(customerId, CustomerUpdateRequest)
activate CustomerApi #7ACFF5

CustomerApi -> CustomerController: PUT /api/v1/customers/{id} (CustomerUpdateRequest, Bearer AT)
activate CustomerController #7ACFF5

CustomerController -> CustomerServiceImpl: updateCustomer(customerId, CustomerUpdateRequest)
activate CustomerServiceImpl #7ACFF5

CustomerServiceImpl -> CustomerRepository: findById(customerId)
activate CustomerRepository #7ACFF5
CustomerRepository -> DB: SELECT * FROM customers WHERE id=?
activate DB #7ACFF5
DB --> CustomerRepository: Customer entity
deactivate DB
CustomerRepository --> CustomerServiceImpl: Customer
deactivate CustomerRepository

CustomerServiceImpl -> CustomerRepository: existsByPhoneAndIdNot(newPhone, customerId)
activate CustomerRepository #7ACFF5
CustomerRepository -> DB: SELECT COUNT(*) FROM customers WHERE phone=? AND id != ?
activate DB #7ACFF5
DB --> CustomerRepository: count
deactivate DB
CustomerRepository --> CustomerServiceImpl: boolean (isPhoneDuplicated)
deactivate CustomerRepository

alt New phone number belongs to another customer
    CustomerServiceImpl --> CustomerController: throw CustomerPhoneAlreadyExistsException("Số điện thoại đã thuộc về một khách hàng khác")
    CustomerController --> CustomerApi: HTTP 409 Conflict
    CustomerApi --> CustomerFormModal: Error response
    CustomerFormModal --> Pharmacist: Show error message "Số điện thoại đã trùng với khách hàng khác!"
else Valid Request
    CustomerServiceImpl -> CustomerRepository: Update fullName, phone, gender, dateOfBirth, email, address, updatedAt=NOW()
    activate CustomerRepository #7ACFF5
    CustomerRepository -> DB: UPDATE customers SET full_name=?, phone=?, email=?, address=?, updated_at=NOW() WHERE id=?
    activate DB #7ACFF5
    DB --> CustomerRepository: OK
    deactivate DB
    CustomerRepository --> CustomerServiceImpl: OK
    deactivate CustomerRepository

    CustomerServiceImpl -> HealthProfileRepo: findByCustomerId(customerId)
    activate HealthProfileRepo #7ACFF5
    HealthProfileRepo -> DB: SELECT * FROM customer_health_profiles WHERE customer_id=?
    activate DB #7ACFF5
    DB --> HealthProfileRepo: CustomerHealthProfile entity (or empty)
    deactivate DB
    HealthProfileRepo --> CustomerServiceImpl: Optional<CustomerHealthProfile>
    deactivate HealthProfileRepo

    CustomerServiceImpl -> HealthProfileRepo: save(CustomerHealthProfile: allergies, chronicDiseases, notes)
    activate HealthProfileRepo #7ACFF5
    HealthProfileRepo -> DB: UPDATE / INSERT INTO customer_health_profiles (...)
    activate DB #7ACFF5
    DB --> HealthProfileRepo: OK
    deactivate DB
    HealthProfileRepo --> CustomerServiceImpl: OK
    deactivate HealthProfileRepo

    CustomerServiceImpl --> CustomerController: CustomerDetailResponse
    deactivate CustomerServiceImpl

    CustomerController --> CustomerApi: HTTP 200 OK + ApiResponse.success(response)
    deactivate CustomerController

    CustomerApi --> CustomerFormModal: CustomerDetailResponse
    deactivate CustomerApi

    CustomerFormModal -> CustomerFormModal: Close modal, refresh customer list table
    CustomerFormModal --> Pharmacist: Show Toast notification "Cập nhật thông tin khách hàng thành công!"
end

deactivate CustomerFormModal
deactivate Pharmacist
@enduml