@startuml SQ06_Register_New_Customer
title UC27 - Register New Customer Sequence Diagram (Code-based Flow)
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "Pharmacist" as Pharmacist #7ACFF5
participant "<<boundary>>\nCustomerFormModal.jsx" as CustomerFormModal #7ACFF5
participant "<<control>>\ncustomerApi.js" as CustomerApi #7ACFF5
participant "<<control>>\nCustomerController" as CustomerController #7ACFF5
participant "<<control>>\nCustomerServiceImpl" as CustomerServiceImpl #7ACFF5
participant "<<entity>>\nCustomerRepository" as CustomerRepository #7ACFF5
participant "<<entity>>\nCustomerHealthProfileRepository" as HealthProfileRepo #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate Pharmacist #7ACFF5
Pharmacist -> CustomerFormModal: Open modal, enter fullName, phone, gender, dob, allergies, click "Lưu khách hàng"
activate CustomerFormModal #7ACFF5

CustomerFormModal -> CustomerFormModal: Client validation (fullName != empty, valid Vietnamese phone 10 digits)
CustomerFormModal -> CustomerApi: createCustomer(CustomerCreateRequest)
activate CustomerApi #7ACFF5

CustomerApi -> CustomerController: POST /api/v1/customers (CustomerCreateRequest, Bearer AT)
activate CustomerController #7ACFF5

CustomerController -> CustomerServiceImpl: registerCustomer(CustomerCreateRequest)
activate CustomerServiceImpl #7ACFF5

CustomerServiceImpl -> CustomerRepository: existsByPhone(phone)
activate CustomerRepository #7ACFF5
CustomerRepository -> DB: SELECT COUNT(*) FROM customers WHERE phone=?
activate DB #7ACFF5
DB --> CustomerRepository: count
deactivate DB
CustomerRepository --> CustomerServiceImpl: boolean (isPhoneExists)
deactivate CustomerRepository

alt Phone number already exists
    CustomerServiceImpl --> CustomerController: throw CustomerPhoneAlreadyExistsException("Số điện thoại đã tồn tại trong hệ thống")
    CustomerController --> CustomerApi: HTTP 409 Conflict
    CustomerApi --> CustomerFormModal: Error response
    CustomerFormModal --> Pharmacist: Display error banner "Số điện thoại đã được đăng ký!"
else Phone number is unique
    CustomerServiceImpl -> CustomerRepository: save(Customer: fullName, phone, gender, email, address, status=1)
    activate CustomerRepository #7ACFF5
    CustomerRepository -> DB: INSERT INTO customers (full_name, phone, gender, email, address, status=1, ...)
    activate DB #7ACFF5
    DB --> CustomerRepository: Customer entity (id=105)
    deactivate DB
    CustomerRepository --> CustomerServiceImpl: savedCustomer
    deactivate CustomerRepository

    opt Health profile details provided (allergies, chronic diseases, notes)
        CustomerServiceImpl -> HealthProfileRepo: save(CustomerHealthProfile: customer, allergies, chronicDiseases, notes)
        activate HealthProfileRepo #7ACFF5
        HealthProfileRepo -> DB: INSERT INTO customer_health_profiles (...)
        activate DB #7ACFF5
        DB --> HealthProfileRepo: OK
        deactivate DB
        HealthProfileRepo --> CustomerServiceImpl: OK
        deactivate HealthProfileRepo
    end

    CustomerServiceImpl --> CustomerController: CustomerDetailResponse (id, fullName, phone, allergyInfo)
    deactivate CustomerServiceImpl

    CustomerController --> CustomerApi: HTTP 201 Created + ApiResponse.success(response)
    deactivate CustomerController

    CustomerApi --> CustomerFormModal: CustomerDetailResponse
    deactivate CustomerApi

    CustomerFormModal -> CustomerFormModal: Close modal, trigger onCustomerCreated callback
    CustomerFormModal --> Pharmacist: Show Toast "Đăng ký khách hàng mới thành công!"
end

deactivate CustomerFormModal
deactivate Pharmacist
@enduml