@startuml SQ06_Register_New_Customer
title UC29 - Register New Customer Sequence Diagram
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "Pharmacist" as Pharmacist #7ACFF5
participant "<<boundary>>\nCustomerFormModal" as CustomerFormModal #7ACFF5
participant "<<control>>\nCustomerController" as CustomerController #7ACFF5
participant "<<control>>\nCustomerServiceImpl" as CustomerServiceImpl #7ACFF5
participant "<<entity>>\nCustomerRepository" as CustomerRepository #7ACFF5
participant "<<entity>>\nCustomerHealthProfileRepository" as HealthProfileRepo #7ACFF5
participant "<<entity>>\nAuditLogRepository" as AuditLogRepo #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate Pharmacist #7ACFF5
Pharmacist -> CustomerFormModal: Input fullName, phone, gender, allergies, click "Lưu khách hàng"
activate CustomerFormModal #7ACFF5

CustomerFormModal -> CustomerFormModal: Client-side Validation (phone 10 digits, fullName not blank)

CustomerFormModal -> CustomerController: POST /api/v1/customers (CustomerCreateRequest, Bearer AT)
activate CustomerController #7ACFF5

CustomerController -> CustomerServiceImpl: registerCustomer(CustomerCreateRequest)
activate CustomerServiceImpl #7ACFF5

CustomerServiceImpl -> CustomerRepository: existsByPhone(phone)
activate CustomerRepository #7ACFF5
CustomerRepository -> DB: SELECT COUNT(*) FROM customers WHERE phone=?
activate DB #7ACFF5
DB --> CustomerRepository: count
deactivate DB
CustomerRepository --> CustomerServiceImpl: boolean (isPhoneExists)
deactivate CustomerRepository

alt Phone already registered
    CustomerServiceImpl --> CustomerController: throw DuplicateResourceException("Số điện thoại đã được đăng ký")
    CustomerController --> CustomerFormModal: HTTP 409 Conflict
    CustomerFormModal --> Pharmacist: Display warning "Số điện thoại này đã có trên hệ thống"
else Valid Phone
    CustomerServiceImpl -> CustomerServiceImpl: generateCustomerCode() -> 'KH-000108'
    CustomerServiceImpl -> CustomerRepository: save(Customer entity)
    activate CustomerRepository #7ACFF5
    CustomerRepository -> DB: INSERT INTO customers (code, full_name, phone, gender, loyalty_points=0, status=1)
    activate DB #7ACFF5
    DB --> CustomerRepository: Customer saved (id=108)
    deactivate DB
    CustomerRepository --> CustomerServiceImpl: savedCustomer
    deactivate CustomerRepository

    opt Has Health Profile Data (height, weight, allergies...)
        CustomerServiceImpl -> HealthProfileRepo: save(CustomerHealthProfile)
        activate HealthProfileRepo #7ACFF5
        HealthProfileRepo -> DB: INSERT INTO customer_health_profiles (customer_id, allergies, chronic_diseases...)
        activate DB #7ACFF5
        DB --> HealthProfileRepo: OK
        deactivate DB
        HealthProfileRepo --> CustomerServiceImpl: OK
        deactivate HealthProfileRepo
    end

    CustomerServiceImpl -> AuditLogRepo: save(AuditLog 'CREATE_CUSTOMER_SUCCESS')
    activate AuditLogRepo #7ACFF5
    AuditLogRepo -> DB: INSERT INTO audit_logs (...)
    activate DB #7ACFF5
    DB --> AuditLogRepo: OK
    deactivate DB
    AuditLogRepo --> CustomerServiceImpl: OK
    deactivate AuditLogRepo

    CustomerServiceImpl --> CustomerController: CustomerDetailResponse
    deactivate CustomerServiceImpl

    CustomerController --> CustomerFormModal: HTTP 201 Created + CustomerDetailResponse
    deactivate CustomerController

    CustomerFormModal -> CustomerFormModal: Auto-assign customer to POS Cart if in checkout
    CustomerFormModal --> Pharmacist: Close modal, display Toast "Tạo hồ sơ khách hàng thành công!"
end

deactivate CustomerFormModal
deactivate Pharmacist
@enduml
