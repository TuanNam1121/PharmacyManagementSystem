@startuml SQ08_View_Customer_Detail
title UC29 - View Customer Detail Sequence Diagram (Code-based Flow)
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "Pharmacist" as Pharmacist #7ACFF5
participant "<<boundary>>\nCustomerDirectoryPage.jsx" as DirectoryPage #7ACFF5
participant "<<boundary>>\nCustomerDetailModal.jsx" as DetailModal #7ACFF5
participant "<<control>>\ncustomerApi.js" as CustomerApi #7ACFF5
participant "<<control>>\nCustomerController" as CustomerController #7ACFF5
participant "<<control>>\nCustomerServiceImpl" as CustomerServiceImpl #7ACFF5
participant "<<entity>>\nCustomerRepository" as CustomerRepository #7ACFF5
participant "<<entity>>\nCustomerHealthProfileRepository" as HealthProfileRepo #7ACFF5
participant "<<entity>>\nSalesInvoiceRepository" as InvoiceRepo #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate Pharmacist #7ACFF5
Pharmacist -> DirectoryPage: Click "Xem chi tiết" icon on customer row
activate DirectoryPage #7ACFF5

DirectoryPage -> DetailModal: Set selectedCustomerId and open modal
activate DetailModal #7ACFF5

DetailModal -> CustomerApi: getCustomerById(customerId)
activate CustomerApi #7ACFF5

CustomerApi -> CustomerController: GET /api/v1/customers/{id} (Bearer AT)
activate CustomerController #7ACFF5

CustomerController -> CustomerServiceImpl: getCustomerDetail(customerId)
activate CustomerServiceImpl #7ACFF5

CustomerServiceImpl -> CustomerRepository: findById(customerId)
activate CustomerRepository #7ACFF5
CustomerRepository -> DB: SELECT * FROM customers WHERE id=?
activate DB #7ACFF5
DB --> CustomerRepository: Customer entity
deactivate DB
CustomerRepository --> CustomerServiceImpl: Customer
deactivate CustomerRepository

CustomerServiceImpl -> HealthProfileRepo: findByCustomerId(customerId)
activate HealthProfileRepo #7ACFF5
HealthProfileRepo -> DB: SELECT * FROM customer_health_profiles WHERE customer_id=?
activate DB #7ACFF5
DB --> HealthProfileRepo: CustomerHealthProfile entity
deactivate DB
HealthProfileRepo --> CustomerServiceImpl: Optional<CustomerHealthProfile>
deactivate HealthProfileRepo

CustomerServiceImpl -> InvoiceRepo: countByCustomerIdAndStatus(customerId, 1)
activate InvoiceRepo #7ACFF5
InvoiceRepo -> DB: SELECT COUNT(*), SUM(final_amount) FROM sales_invoices WHERE customer_id=? AND status=1
activate DB #7ACFF5
DB --> InvoiceRepo: totalInvoices, totalSpent
deactivate DB
InvoiceRepo --> CustomerServiceImpl: Purchase summary metrics
deactivate InvoiceRepo

CustomerServiceImpl -> CustomerServiceImpl: mapToCustomerDetailResponse(customer, healthProfile, metrics)
activate CustomerServiceImpl #7ACFF5
deactivate CustomerServiceImpl

CustomerServiceImpl --> CustomerController: CustomerDetailResponse (personal info, allergy notes, totalSpent, loyaltyPoints)
deactivate CustomerServiceImpl

CustomerController --> CustomerApi: HTTP 200 OK + ApiResponse.success(response)
deactivate CustomerController

CustomerApi --> DetailModal: CustomerDetailResponse
deactivate CustomerApi

DetailModal -> DetailModal: Render profile tabs (Thông tin cá nhân, Hồ sơ sức khỏe, Lịch sử mua)
opt Has active drug allergy notes
    DetailModal -> DetailModal: Render prominent red Alert Box: "⚠️ Cảnh báo tiền sử dị ứng thuốc: [Danh sách]"
end

DetailModal --> Pharmacist: Display detailed Customer Modal dialog
deactivate DetailModal
deactivate DirectoryPage
deactivate Pharmacist
@enduml