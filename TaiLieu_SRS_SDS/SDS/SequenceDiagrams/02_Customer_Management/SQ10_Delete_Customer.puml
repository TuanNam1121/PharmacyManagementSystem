@startuml SQ10_Delete_Customer
title UC31 - Delete Customer Sequence Diagram (Code-based Flow)
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "Manager" as Manager #7ACFF5
participant "<<boundary>>\nCustomerDirectoryPage.jsx" as DirectoryPage #7ACFF5
participant "<<boundary>>\nConfirmDeleteModal.jsx" as ConfirmModal #7ACFF5
participant "<<control>>\ncustomerApi.js" as CustomerApi #7ACFF5
participant "<<control>>\nCustomerController" as CustomerController #7ACFF5
participant "<<control>>\nCustomerServiceImpl" as CustomerServiceImpl #7ACFF5
participant "<<entity>>\nCustomerRepository" as CustomerRepository #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate Manager #7ACFF5
Manager -> DirectoryPage: Click "Xóa" (Trash icon) on customer row
activate DirectoryPage #7ACFF5

DirectoryPage -> ConfirmModal: Open confirmation popup (customerId, customerName)
activate ConfirmModal #7ACFF5

Manager -> ConfirmModal: Input deactivation reason, click "Xác nhận xóa"
ConfirmModal -> CustomerApi: deleteCustomer(customerId, reason)
activate CustomerApi #7ACFF5

CustomerApi -> CustomerController: DELETE /api/v1/customers/{id}?reason=... (Bearer AT)
activate CustomerController #7ACFF5

CustomerController -> CustomerServiceImpl: deleteCustomer(customerId, reason)
activate CustomerServiceImpl #7ACFF5

CustomerServiceImpl -> CustomerRepository: findById(customerId)
activate CustomerRepository #7ACFF5
CustomerRepository -> DB: SELECT * FROM customers WHERE id=?
activate DB #7ACFF5
DB --> CustomerRepository: Customer entity
deactivate DB
CustomerRepository --> CustomerServiceImpl: Customer
deactivate CustomerRepository

alt Customer already inactive (status == 0)
    CustomerServiceImpl --> CustomerController: throw IllegalStateException("Khách hàng này đã ở trạng thái ngừng hoạt động")
    CustomerController --> CustomerApi: HTTP 400 Bad Request
    CustomerApi --> ConfirmModal: Error response
    ConfirmModal --> Manager: Show warning message
else Customer is Active
    CustomerServiceImpl -> CustomerRepository: customer.setStatus((short) 0), customer.setUpdatedAt(NOW())
    activate CustomerRepository #7ACFF5
    CustomerRepository -> DB: UPDATE customers SET status=0, updated_at=NOW() WHERE id=?
    activate DB #7ACFF5
    DB --> CustomerRepository: OK (Preserve historical transaction integrity)
    deactivate DB
    CustomerRepository --> CustomerServiceImpl: OK
    deactivate CustomerRepository

    CustomerServiceImpl --> CustomerController: void
    deactivate CustomerServiceImpl

    CustomerController --> CustomerApi: HTTP 200 OK + ApiResponse.success("Vô hiệu hóa khách hàng thành công")
    deactivate CustomerController

    CustomerApi --> ConfirmModal: Success response
    deactivate CustomerApi

    ConfirmModal -> DirectoryPage: Remove/update customer row in local state
    deactivate ConfirmModal

    DirectoryPage --> Manager: Close modal, show Toast "Đã ngừng theo dõi khách hàng thành công!"
end

deactivate DirectoryPage
deactivate Manager
@enduml