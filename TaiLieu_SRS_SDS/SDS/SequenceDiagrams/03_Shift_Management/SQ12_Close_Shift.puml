@startuml SQ12_Close_Shift
title UC20 - Close Shift Sequence Diagram (Code-based Flow)
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "Pharmacist" as Pharmacist #7ACFF5
participant "<<boundary>>\nPosCounterPage.jsx" as PosCounterPage #7ACFF5
participant "<<boundary>>\nCloseShiftModal.jsx" as CloseShiftModal #7ACFF5
participant "<<control>>\nshiftApi.js" as ShiftApi #7ACFF5
participant "<<control>>\nShiftController" as ShiftController #7ACFF5
participant "<<control>>\nShiftServiceImpl" as ShiftServiceImpl #7ACFF5
participant "<<entity>>\nShiftRepository" as ShiftRepository #7ACFF5
participant "<<entity>>\nPaymentRepository" as PaymentRepository #7ACFF5
participant "<<entity>>\nSalesReturnRepository" as SalesReturnRepo #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate Pharmacist #7ACFF5
== Phase 1: Retrieve Shift Revenue Summary ==
Pharmacist -> PosCounterPage: Click "Chốt ca làm việc"
activate PosCounterPage #7ACFF5

PosCounterPage -> CloseShiftModal: Open close shift modal
activate CloseShiftModal #7ACFF5

CloseShiftModal -> ShiftApi: getCurrentShiftSummary()
activate ShiftApi #7ACFF5

ShiftApi -> ShiftController: GET /api/v1/shifts/current/summary (Bearer AT)
activate ShiftController #7ACFF5

ShiftController -> ShiftServiceImpl: getCurrentShiftSummary(accountId)
activate ShiftServiceImpl #7ACFF5

ShiftServiceImpl -> ShiftRepository: findFirstByAccount_IdAndStatus(accountId, 1)
activate ShiftRepository #7ACFF5
ShiftRepository -> DB: SELECT * FROM shifts WHERE account_id=? AND status=1
activate DB #7ACFF5
DB --> ShiftRepository: Shift entity (openShift)
deactivate DB
ShiftRepository --> ShiftServiceImpl: Shift
deactivate ShiftRepository

ShiftServiceImpl -> PaymentRepository: sumAmountByShiftAndMethod(shift.getId(), method=1) -- CASH
activate PaymentRepository #7ACFF5
PaymentRepository -> DB: SELECT SUM(p.amount) FROM payments p JOIN sales_invoices i ON p.sales_invoice_id=i.id WHERE i.shift_id=? AND p.payment_method=1
activate DB #7ACFF5
DB --> PaymentRepository: cashSales (e.g. 8,500,000 VND)
deactivate DB
PaymentRepository --> ShiftServiceImpl: BigDecimal
deactivate PaymentRepository

ShiftServiceImpl -> PaymentRepository: sumAmountByShiftAndMethod(shift.getId(), method=3) -- VIETQR
activate PaymentRepository #7ACFF5
PaymentRepository -> DB: SELECT SUM(p.amount) FROM payments p JOIN sales_invoices i ON p.sales_invoice_id=i.id WHERE i.shift_id=? AND p.payment_method=3
activate DB #7ACFF5
DB --> PaymentRepository: qrSales (e.g. 3,200,000 VND)
deactivate DB
PaymentRepository --> ShiftServiceImpl: BigDecimal
deactivate PaymentRepository

ShiftServiceImpl -> SalesReturnRepo: sumCashRefundsByShift(shift.getId())
activate SalesReturnRepo #7ACFF5
SalesReturnRepo -> DB: SELECT SUM(refund_amount) FROM sales_returns WHERE shift_id=? AND refund_method=1
activate DB #7ACFF5
DB --> SalesReturnRepo: cashRefunds (e.g. 200,000 VND)
deactivate DB
SalesReturnRepo --> ShiftServiceImpl: BigDecimal
deactivate SalesReturnRepo

ShiftServiceImpl -> ShiftServiceImpl: Calculate expectedCash = openingCash + cashSales - cashRefunds
activate ShiftServiceImpl #7ACFF5
deactivate ShiftServiceImpl

ShiftServiceImpl --> ShiftController: ShiftSummaryResponse (openingCash, cashSales, qrSales, cashRefunds, expectedCash)
deactivate ShiftServiceImpl

ShiftController --> ShiftApi: HTTP 200 OK + ApiResponse.success(response)
deactivate ShiftController

ShiftApi --> CloseShiftModal: ShiftSummaryResponse
deactivate ShiftApi

CloseShiftModal --> Pharmacist: Display shift revenue metrics and expected cash in drawer (9,800,000 VND)

== Phase 2: Enter Actual Cash & Finalize Close Shift ==
Pharmacist -> CloseShiftModal: Count drawer cash, input actualCash (9,800,000 VND), note, click "Xác nhận chốt ca"
CloseShiftModal -> CloseShiftModal: Compute difference = actualCash - expectedCash (0 VND)

CloseShiftModal -> ShiftApi: closeShift({ shiftId, actualCash, note })
activate ShiftApi #7ACFF5

ShiftApi -> ShiftController: POST /api/v1/shifts/close (CloseShiftRequest, Bearer AT)
activate ShiftController #7ACFF5

ShiftController -> ShiftServiceImpl: closeShift(CloseShiftRequest, accountId)
activate ShiftServiceImpl #7ACFF5

ShiftServiceImpl -> ShiftRepository: findById(shiftId)
activate ShiftRepository #7ACFF5
ShiftRepository --> ShiftServiceImpl: Shift entity
deactivate ShiftRepository

ShiftServiceImpl -> ShiftServiceImpl: Set closedAt=NOW(), actualCash, difference, status=2 (CLOSED)
activate ShiftServiceImpl #7ACFF5
deactivate ShiftServiceImpl

ShiftServiceImpl -> ShiftRepository: save(Shift)
activate ShiftRepository #7ACFF5
ShiftRepository -> DB: UPDATE shifts SET closed_at=NOW(), closing_cash=?, difference=0, status=2 WHERE id=?
activate DB #7ACFF5
DB --> ShiftRepository: OK
deactivate DB
ShiftRepository --> ShiftServiceImpl: OK
deactivate ShiftRepository

ShiftServiceImpl --> ShiftController: ShiftDetailResponse
deactivate ShiftServiceImpl

ShiftController --> ShiftApi: HTTP 200 OK + ApiResponse.success(response)
deactivate ShiftController

ShiftApi --> CloseShiftModal: ShiftDetailResponse
deactivate ShiftApi

CloseShiftModal -> PosCounterPage: Clear currentShift state, lock POS terminal
deactivate CloseShiftModal

PosCounterPage --> Pharmacist: Show Toast "Chốt ca thành công!", display K80 Shift Handover Report
deactivate PosCounterPage
deactivate Pharmacist
@enduml