@startuml SQ03_Change_Password
title UC03 - Change Password Sequence Diagram (Code-based Flow)
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "User" as User #7ACFF5
participant "<<boundary>>\nProfilePage.jsx" as ProfilePage #7ACFF5
participant "<<control>>\nprofileApi.js" as ProfileApi #7ACFF5
participant "<<control>>\nAccountProfileController" as ProfileController #7ACFF5
participant "<<control>>\nProfileServiceImpl" as ProfileServiceImpl #7ACFF5
participant "<<control>>\nPasswordEncoder" as PasswordEncoder #7ACFF5
participant "<<entity>>\nAccountRepository" as AccountRepository #7ACFF5
participant "<<entity>>\nAuditLogRepository" as AuditLogRepo #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate User #7ACFF5
User -> ProfilePage: Select "Đổi mật khẩu" tab, enter currentPassword, newPassword, confirmPassword, click "Cập nhật mật khẩu"
activate ProfilePage #7ACFF5

ProfilePage -> ProfilePage: Client validation (newPassword === confirmPassword, length >= 6)
ProfilePage -> ProfileApi: changePassword({ currentPassword, newPassword, confirmPassword })
activate ProfileApi #7ACFF5

ProfileApi -> ProfileController: PUT /api/v1/profile/change-password (ChangePasswordRequest, Bearer AT)
activate ProfileController #7ACFF5

ProfileController -> ProfileServiceImpl: changePassword(accountId, ChangePasswordRequest, clientIp)
activate ProfileServiceImpl #7ACFF5

ProfileServiceImpl -> AccountRepository: findById(accountId)
activate AccountRepository #7ACFF5
AccountRepository -> DB: SELECT * FROM accounts WHERE id=?
activate DB #7ACFF5
DB --> AccountRepository: Account entity
deactivate DB
AccountRepository --> ProfileServiceImpl: Account
deactivate AccountRepository

ProfileServiceImpl -> PasswordEncoder: matches(currentPassword, account.getPassword())
activate PasswordEncoder #7ACFF5
PasswordEncoder --> ProfileServiceImpl: boolean (isCurrentMatch)
deactivate PasswordEncoder

alt Current password invalid
    ProfileServiceImpl --> ProfileController: throw BadCredentialsException("Mật khẩu hiện tại không chính xác")
    ProfileController --> ProfileApi: HTTP 400 Bad Request
    ProfileApi --> ProfilePage: Error response
    ProfilePage --> User: Display error "Mật khẩu hiện tại không chính xác"
else New password same as current password
    ProfileServiceImpl -> PasswordEncoder: matches(newPassword, account.getPassword())
    activate PasswordEncoder #7ACFF5
    PasswordEncoder --> ProfileServiceImpl: true
    deactivate PasswordEncoder
    ProfileServiceImpl --> ProfileController: throw IllegalArgumentException("Mật khẩu mới không được trùng với mật khẩu hiện tại")
    ProfileController --> ProfileApi: HTTP 400 Bad Request
    ProfileApi --> ProfilePage: Error response
    ProfilePage --> User: Display error "Mật khẩu mới không được trùng với mật khẩu hiện tại"
else Valid Request
    ProfileServiceImpl -> PasswordEncoder: encode(newPassword)
    activate PasswordEncoder #7ACFF5
    PasswordEncoder --> ProfileServiceImpl: hashedNewPassword
    deactivate PasswordEncoder

    ProfileServiceImpl -> AccountRepository: account.setPassword(hashedNewPassword), account.setUpdatedAt(NOW())
    activate AccountRepository #7ACFF5
    AccountRepository -> DB: UPDATE accounts SET password=?, updated_at=NOW() WHERE id=?
    activate DB #7ACFF5
    DB --> AccountRepository: OK
    deactivate DB
    AccountRepository --> ProfileServiceImpl: OK
    deactivate AccountRepository

    ProfileServiceImpl -> AuditLogRepo: recordAuditLog(account, 'CHANGE_PASSWORD_SUCCESS', clientIp)
    activate AuditLogRepo #7ACFF5
    AuditLogRepo -> DB: INSERT INTO audit_logs (...)
    activate DB #7ACFF5
    DB --> AuditLogRepo: OK
    deactivate DB
    AuditLogRepo --> ProfileServiceImpl: OK
    deactivate AuditLogRepo

    ProfileServiceImpl --> ProfileController: void
    deactivate ProfileServiceImpl

    ProfileController --> ProfileApi: HTTP 200 OK + ApiResponse.success("Đổi mật khẩu thành công")
    deactivate ProfileController

    ProfileApi --> ProfilePage: Success response
    deactivate ProfileApi

    ProfilePage -> ProfilePage: Reset form input fields
    ProfilePage --> User: Show Toast notification "Đổi mật khẩu thành công!"
end

deactivate ProfilePage
deactivate User
@enduml