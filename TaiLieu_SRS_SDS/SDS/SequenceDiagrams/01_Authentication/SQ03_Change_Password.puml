@startuml SQ03_Change_Password
title UC03 - Change Password Sequence Diagram
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "User" as User #7ACFF5
participant "<<boundary>>\nChangePasswordModal" as ChangePasswordModal #7ACFF5
participant "<<control>>\nAccountProfileController" as ProfileController #7ACFF5
participant "<<control>>\nAccountProfileServiceImpl" as ProfileServiceImpl #7ACFF5
participant "<<control>>\nBCryptPasswordEncoder" as BCryptEncoder #7ACFF5
participant "<<entity>>\nAccountRepository" as AccountRepository #7ACFF5
participant "<<entity>>\nRefreshTokenRepository" as RefreshTokenRepo #7ACFF5
participant "<<entity>>\nAuditLogRepository" as AuditLogRepo #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate User #7ACFF5
User -> ChangePasswordModal: Input currentPassword, newPassword, confirmPassword, click "Cập nhật"
activate ChangePasswordModal #7ACFF5

ChangePasswordModal -> ChangePasswordModal: Validate complexity (len >= 8, special char, match)

ChangePasswordModal -> ProfileController: POST /api/v1/profile/change-password (ChangePasswordRequest, Bearer AT)
activate ProfileController #7ACFF5

ProfileController -> ProfileServiceImpl: changePassword(accountId, request, response)
activate ProfileServiceImpl #7ACFF5

ProfileServiceImpl -> AccountRepository: findById(accountId)
activate AccountRepository #7ACFF5
AccountRepository -> DB: SELECT * FROM accounts WHERE id=?
activate DB #7ACFF5
DB --> AccountRepository: Account entity
deactivate DB
AccountRepository --> ProfileServiceImpl: Account
deactivate AccountRepository

ProfileServiceImpl -> BCryptEncoder: matches(request.getCurrentPassword(), account.getPassword())
activate BCryptEncoder #7ACFF5
BCryptEncoder --> ProfileServiceImpl: boolean (isCurrentPasswordValid)
deactivate BCryptEncoder

alt Current Password does not match
    ProfileServiceImpl --> ProfileController: throw InvalidPasswordException("Mật khẩu hiện tại không đúng")
    ProfileController --> ChangePasswordModal: HTTP 400 Bad Request
    ChangePasswordModal --> User: Show error "Mật khẩu hiện tại không chính xác"
else New Password same as Current Password
    ProfileServiceImpl --> ProfileController: throw BadRequestException("Mật khẩu mới không được trùng mật khẩu cũ")
    ProfileController --> ChangePasswordModal: HTTP 400 Bad Request
    ChangePasswordModal --> User: Show warning "Mật khẩu mới không được trùng mật khẩu hiện tại"
else Valid New Password
    ProfileServiceImpl -> BCryptEncoder: encode(request.getNewPassword())
    activate BCryptEncoder #7ACFF5
    BCryptEncoder --> ProfileServiceImpl: encodedNewPassword
    deactivate BCryptEncoder

    ProfileServiceImpl -> AccountRepository: account.setPassword(encodedNewPassword)
    activate AccountRepository #7ACFF5
    AccountRepository -> DB: UPDATE accounts SET password=?, updated_at=NOW() WHERE id=?
    activate DB #7ACFF5
    DB --> AccountRepository: OK
    deactivate DB
    AccountRepository --> ProfileServiceImpl: OK
    deactivate AccountRepository

    ProfileServiceImpl -> RefreshTokenRepo: revokeAllByAccount_Id(accountId)
    activate RefreshTokenRepo #7ACFF5
    RefreshTokenRepo -> DB: UPDATE refresh_tokens SET is_revoked=1 WHERE account_id=?
    activate DB #7ACFF5
    DB --> RefreshTokenRepo: OK (Revoke all active sessions)
    deactivate DB
    RefreshTokenRepo --> ProfileServiceImpl: OK
    deactivate RefreshTokenRepo

    ProfileServiceImpl -> AuditLogRepo: save(AuditLog 'CHANGE_PASSWORD_SUCCESS')
    activate AuditLogRepo #7ACFF5
    AuditLogRepo -> DB: INSERT INTO audit_logs (...)
    activate DB #7ACFF5
    DB --> AuditLogRepo: OK
    deactivate DB
    AuditLogRepo --> ProfileServiceImpl: OK
    deactivate AuditLogRepo

    ProfileServiceImpl --> ProfileController: void (Success)
    deactivate ProfileServiceImpl

    ProfileController --> ChangePasswordModal: HTTP 200 OK ("Đổi mật khẩu thành công")
    deactivate ProfileController

    ChangePasswordModal --> User: Display Toast success message and close modal
end

deactivate ChangePasswordModal
deactivate User
@enduml
