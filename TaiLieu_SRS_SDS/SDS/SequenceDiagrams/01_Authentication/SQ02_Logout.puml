@startuml SQ02_Logout
title UC02 - User Logout Sequence Diagram (Code-based Flow)
autonumber "1:"
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #7ACFF5
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #7ACFF5
    ParticipantFontColor #000000
    ParticipantFontSize 12
    ActorBorderColor #000000
    ActorBackgroundColor #7ACFF5
    ActorFontColor #000000
    ArrowColor #000000
    ArrowFontColor #000000
    GroupBorderColor #000000
}

actor "User" as User #7ACFF5
participant "<<boundary>>\nSidebar / Header" as Header #7ACFF5
participant "<<control>>\nAuthContext.jsx" as AuthContext #7ACFF5
participant "<<control>>\nauthApi.js" as AuthApi #7ACFF5
participant "<<control>>\nAuthController" as AuthController #7ACFF5
participant "<<control>>\nAuthServiceImpl" as AuthServiceImpl #7ACFF5
participant "<<entity>>\nRefreshTokenRepository" as RefreshTokenRepo #7ACFF5
participant "<<entity>>\nAuditLogRepository" as AuditLogRepo #7ACFF5
database "<<entity>>\nSQL Server (PMS DB)" as DB #7ACFF5

activate User #7ACFF5
User -> Header: Click "Đăng xuất"
activate Header #7ACFF5

Header -> AuthContext: logout()
activate AuthContext #7ACFF5

AuthContext -> AuthApi: logout()
activate AuthApi #7ACFF5

AuthApi -> AuthController: POST /api/v1/auth/logout (Bearer AT, Cookie: refreshToken)
activate AuthController #7ACFF5

AuthController -> AuthServiceImpl: logout(authHeader, requestRefreshToken, clientIp)
activate AuthServiceImpl #7ACFF5

opt Refresh Token present in Cookie
    AuthServiceImpl -> RefreshTokenRepo: findByToken(requestRefreshToken)
    activate RefreshTokenRepo #7ACFF5
    RefreshTokenRepo -> DB: SELECT * FROM refresh_tokens WHERE token=?
    activate DB #7ACFF5
    DB --> RefreshTokenRepo: RefreshToken entity
    deactivate DB
    RefreshTokenRepo --> AuthServiceImpl: Optional<RefreshToken>
    deactivate RefreshTokenRepo

    AuthServiceImpl -> RefreshTokenRepo: token.setRevoked(true)
    activate RefreshTokenRepo #7ACFF5
    RefreshTokenRepo -> DB: UPDATE refresh_tokens SET revoked=1 WHERE id=?
    activate DB #7ACFF5
    DB --> RefreshTokenRepo: OK
    deactivate DB
    RefreshTokenRepo --> AuthServiceImpl: OK
    deactivate RefreshTokenRepo
end

AuthServiceImpl -> AuditLogRepo: recordAuditLog(account, 'LOGOUT_SUCCESS', clientIp)
activate AuditLogRepo #7ACFF5
AuditLogRepo -> DB: INSERT INTO audit_logs (...)
activate DB #7ACFF5
DB --> AuditLogRepo: OK
deactivate DB
AuditLogRepo --> AuthServiceImpl: OK
deactivate AuditLogRepo

AuthServiceImpl --> AuthController: void
deactivate AuthServiceImpl

AuthController -> AuthController: Expire Set-Cookie: refreshToken (maxAge=0)
AuthController --> AuthApi: HTTP 200 OK + ApiResponse.success("Đăng xuất thành công")
deactivate AuthController

AuthApi --> AuthContext: Resolve promise
deactivate AuthApi

AuthContext -> AuthContext: localStorage.removeItem('token'), clear user state
AuthContext --> Header: Updated session state
deactivate AuthContext

Header --> User: Redirect to Login Page (/login)
deactivate Header
deactivate User
@enduml