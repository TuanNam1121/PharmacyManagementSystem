@startuml CD01_Error_Handling
title Common Design - Error Handling Compact Class Diagram
scale 0.8
skinparam style strictuml
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam classAttributeIconSize 0
skinparam nodesep 18
skinparam ranksep 20
skinparam packagePadding 8
skinparam classPadding 2

skinparam class {
    BorderColor #000000
    BackgroundColor #7ACFF5
    HeaderBackgroundColor #7ACFF5
    FontColor #000000
    FontSize 10
    StereotypeFontColor #000000
    StereotypeFontSize 9
    ArrowColor #000000
}

package "com.pharmacy.exception" {

    class RuntimeException <<Standard>> {
        + getMessage(): String
    }

    abstract class BusinessException <<entity>> {
        # message: String
        + BusinessException(message: String)
    }

    class BadCredentialsException <<entity>>
    class AccountLockedException <<entity>>
    class ResourceNotFoundException <<entity>>
    class DuplicateResourceException <<entity>>
    class CustomerPhoneAlreadyExistsException <<entity>>
    class InsufficientStockException <<entity>>
    class NoOpenShiftException <<entity>>
    class ShiftAlreadyOpenException <<entity>>
    class InvalidTokenException <<entity>>

    RuntimeException <|-- BusinessException
    BusinessException <|-- BadCredentialsException
    BusinessException <|-- AccountLockedException
    BusinessException <|-- ResourceNotFoundException
    BusinessException <|-- DuplicateResourceException
    DuplicateResourceException <|-- CustomerPhoneAlreadyExistsException
    BusinessException <|-- InsufficientStockException
    BusinessException <|-- NoOpenShiftException
    BusinessException <|-- ShiftAlreadyOpenException
    BusinessException <|-- InvalidTokenException

    class GlobalExceptionHandler <<control>> {
        + handleBadCredentials(BadCredentialsException): ResponseEntity
        + handleAccountLocked(AccountLockedException): ResponseEntity
        + handleNotFound(ResourceNotFoundException): ResponseEntity
        + handleDuplicate(DuplicateResourceException): ResponseEntity
        + handleValidation(MethodArgumentNotValidException): ResponseEntity
        + handleStockError(InsufficientStockException): ResponseEntity
        + handleShiftError(NoOpenShiftException): ResponseEntity
        + handleGeneralException(Exception): ResponseEntity
    }

    GlobalExceptionHandler ..> BusinessException : intercepts (4xx)
}

package "com.pharmacy.dto" {
    class "ApiResponse<T>" as ApiResponse <<boundary>> {
        - status: int
        - message: String
        - data: T
        - timestamp: LocalDateTime
        + {static} error(status: int, message: String): ApiResponse<T>
    }
}

GlobalExceptionHandler ..> ApiResponse : produces error response

@enduml