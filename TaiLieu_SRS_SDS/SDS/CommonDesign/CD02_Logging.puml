@startuml CD02_Logging
title Common Design - Logging Compact Class Diagram
scale 0.8
skinparam style strictuml
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam classAttributeIconSize 0
skinparam nodesep 18
skinparam ranksep 20
skinparam packagePadding 8
skinparam classPadding 2

skinparam class {
    BorderColor #000000
    BackgroundColor #7ACFF5
    HeaderBackgroundColor #7ACFF5
    FontColor #000000
    FontSize 10
    StereotypeFontColor #000000
    StereotypeFontSize 9
    ArrowColor #000000
}

package "org.slf4j" {
    interface Logger {
        + info(msg: String, args: Object...): void
        + warn(msg: String, args: Object...): void
        + error(msg: String, t: Throwable): void
    }
}

package "com.pharmacy.entity" {
    class AuditLog <<entity>> {
        - id: Long
        - account: Account
        - action: Short
        - entityName: String
        - entityId: Long
        - oldValue: String
        - newValue: String
        - ipAddress: String
        - createdAt: LocalDateTime
    }

    class Account <<entity>> {
        - id: Long
        - username: String
    }

    AuditLog "0..*" --> "0..1" Account : performed by
}

package "com.pharmacy.repository" {
    interface AuditLogRepository <<entity>> {
        + findAll(spec: Specification, pageable: Pageable): Page<AuditLog>
        + save(log: AuditLog): AuditLog
    }
}

package "com.pharmacy.service" {
    interface AuditLogService <<control>> {
        + getAuditLogs(search, action, entity, pageable): Page<AuditLogDto>
    }

    class AuditLogServiceImpl <<control>> {
        - auditLogRepository: AuditLogRepository
        + getAuditLogs(...): Page<AuditLogDto>
        + recordAuditLog(acc, action, entity, id, val, ip): void
    }

    AuditLogService <|.. AuditLogServiceImpl
    AuditLogServiceImpl --> AuditLogRepository : invokes
    AuditLogRepository ..> AuditLog : persists
    AuditLogServiceImpl ..> Logger : writes system log
}

package "com.pharmacy.controller" {
    class AuditLogController <<control>> {
        - auditLogService: AuditLogService
        + getAuditLogs(...): ResponseEntity<ApiResponse<Page<AuditLogDto>>>
    }

    AuditLogController --> AuditLogService : calls
}

@enduml