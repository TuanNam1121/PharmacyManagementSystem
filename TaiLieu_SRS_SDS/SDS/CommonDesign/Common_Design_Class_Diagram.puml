@startuml Common_Design_Class_Diagram
title Common Design - Compact Class Diagram (Error Handling, Logging, and Messages Processing)
scale 0.75
skinparam style strictuml
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam nodesep 20
skinparam ranksep 22
skinparam packagePadding 8
skinparam classPadding 2

skinparam class {
    BorderColor #000000
    BackgroundColor #7ACFF5
    HeaderBackgroundColor #7ACFF5
    FontColor #000000
    FontSize 10
    StereotypeFontColor #000000
    StereotypeFontSize 9
    ArrowColor #000000
}

skinparam package {
    BorderColor #000000
    BackgroundColor #FFFFFF
    FontColor #000000
    FontSize 11
}

' ==============================================================================
' 1. ERROR HANDLING
' ==============================================================================
package "Error Handling" <<Subsystem>> {

    class RuntimeException <<Standard>> {
        + getMessage(): String
    }

    abstract class BusinessException <<entity>> {
        # message: String
        + BusinessException(message: String)
    }

    class BadCredentialsException <<entity>>
    class AccountLockedException <<entity>>
    class ResourceNotFoundException <<entity>>
    class DuplicateResourceException <<entity>>
    class InsufficientStockException <<entity>>
    class NoOpenShiftException <<entity>>
    class ShiftAlreadyOpenException <<entity>>
    class InvalidTokenException <<entity>>

    RuntimeException <|-- BusinessException
    BusinessException <|-- BadCredentialsException
    BusinessException <|-- AccountLockedException
    BusinessException <|-- ResourceNotFoundException
    BusinessException <|-- DuplicateResourceException
    BusinessException <|-- InsufficientStockException
    BusinessException <|-- NoOpenShiftException
    BusinessException <|-- ShiftAlreadyOpenException
    BusinessException <|-- InvalidTokenException

    class GlobalExceptionHandler <<control>> {
        + handleBadCredentials(BadCredentialsException): ResponseEntity
        + handleAccountLocked(AccountLockedException): ResponseEntity
        + handleNotFound(ResourceNotFoundException): ResponseEntity
        + handleDuplicate(DuplicateResourceException): ResponseEntity
        + handleValidation(MethodArgumentNotValidException): ResponseEntity
        + handleShiftError(NoOpenShiftException): ResponseEntity
        + handleStockError(InsufficientStockException): ResponseEntity
        + handleGeneralException(Exception): ResponseEntity
    }

    GlobalExceptionHandler ..> BusinessException : intercepts & translates
}

' ==============================================================================
' 2. LOGGING & AUDIT TRAIL
' ==============================================================================
package "Logging & Auditing" <<Subsystem>> {

    interface Logger <<SLF4J>> {
        + info(msg: String, args: Object...): void
        + warn(msg: String, args: Object...): void
        + error(msg: String, t: Throwable): void
    }

    class AuditLog <<entity>> {
        - id: Long
        - action: Short
        - entityName: String
        - entityId: Long
        - oldValue: String
        - newValue: String
        - ipAddress: String
        - createdAt: LocalDateTime
    }

    interface AuditLogRepository <<entity>> {
        + save(AuditLog): AuditLog
        + findAll(spec, pageable): Page<AuditLog>
    }

    interface AuditLogService <<control>> {
        + getAuditLogs(search, action, entity, pageable): Page<AuditLogDto>
    }

    class AuditLogServiceImpl <<control>> {
        - auditLogRepository: AuditLogRepository
        + getAuditLogs(...): Page<AuditLogDto>
        + recordAuditLog(acc, action, entity, id, val, ip): void
    }

    class AuditLogController <<control>> {
        - auditLogService: AuditLogService
        + getAuditLogs(...): ResponseEntity<ApiResponse<Page<AuditLogDto>>>
    }

    AuditLogService <|.. AuditLogServiceImpl
    AuditLogServiceImpl --> AuditLogRepository : persists
    AuditLogRepository ..> AuditLog : manages
    AuditLogController --> AuditLogService : invokes
    AuditLogServiceImpl ..> Logger : writes system log
}

' ==============================================================================
' 3. MESSAGES PROCESSING
' ==============================================================================
package "Messages Processing" <<Subsystem>> {

    class "ApiResponse<T>" as ApiResponse <<boundary>> {
        - status: int
        - message: String
        - data: T
        - timestamp: LocalDateTime
        + {static} success(data: T): ApiResponse<T>
        + {static} success(msg: String, data: T): ApiResponse<T>
        + {static} error(status: int, msg: String): ApiResponse<T>
    }

    class "PageResponse<T>" as PageResponse <<boundary>> {
        - content: List<T>
        - pageNumber: int
        - pageSize: int
        - totalElements: long
        - totalPages: int
        - last: boolean
        + {static} from(Page<T>): PageResponse<T>
    }

    interface EmailService <<control>> {
        + sendPasswordResetEmail(to, user, token): boolean
        + sendRfqEmail(rfq, supplier, token, url): boolean
    }

    class EmailServiceImpl <<control>> {
        - mailSender: JavaMailSender
        - emailLogRepository: EmailLogRepository
        + sendPasswordResetEmail(...): boolean
        + sendRfqEmail(...): boolean
    }

    class EmailLog <<entity>> {
        - id: Long
        - toEmail: String
        - subject: String
        - status: Short
        - sentAt: LocalDateTime
    }

    interface EmailLogRepository <<entity>> {
        + save(EmailLog): EmailLog
    }

    EmailService <|.. EmailServiceImpl
    EmailServiceImpl --> EmailLogRepository : logs status
    EmailLogRepository ..> EmailLog : manages
}

' ==============================================================================
' CROSS-CUTTING INTEGRATION ARROWS
' ==============================================================================
GlobalExceptionHandler ..> ApiResponse : wraps error (4xx, 5xx)
AuditLogController ..> ApiResponse : returns audit payload (200)

@enduml