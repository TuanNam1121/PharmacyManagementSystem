@startuml CD00_Common_Design_Overview
title Common Design - Architecture Overview (Error Handling, Logging & Messages Processing)
skinparam style strictuml
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0
skinparam monochrome false

skinparam class {
    BorderColor #000000
    BackgroundColor #7ACFF5
    HeaderBackgroundColor #7ACFF5
    FontColor #000000
    FontSize 11
    StereotypeFontColor #000000
    StereotypeFontSize 10
    ArrowColor #000000
}

skinparam package {
    BorderColor #000000
    BackgroundColor #FFFFFF
    FontColor #000000
    FontSize 12
}

package "Pillar 1: Error Handling" <<Subsystem>> {
    class GlobalExceptionHandler <<control>> {
        + handleCustomBadCredentialsException(ex): ResponseEntity
        + handleValidationException(ex): ResponseEntity
        + handleResourceNotFoundException(ex): ResponseEntity
        + handleDuplicateResourceException(ex): ResponseEntity
        + handleGeneralException(ex): ResponseEntity
    }

    class "BusinessException (Base/Custom)" as CustomExceptions <<entity>> {
        + BadCredentialsException
        + AccountLockedException
        + ResourceNotFoundException
        + DuplicateResourceException
        + InsufficientStockException
        + NoOpenShiftException
    }

    GlobalExceptionHandler ..> CustomExceptions : intercepts
}

package "Pillar 2: Logging & Auditing" <<Subsystem>> {
    class AuditLog <<entity>> {
        - id: Long
        - account: Account
        - action: Short
        - entityName: String
        - entityId: Long
        - oldValue: String
        - newValue: String
        - ipAddress: String
        - createdAt: LocalDateTime
    }

    interface AuditLogRepository <<entity>> {
        + save(auditLog: AuditLog): AuditLog
        + findAll(spec, pageable): Page<AuditLog>
    }

    class AuditLogServiceImpl <<control>> {
        - auditLogRepository: AuditLogRepository
        + getAuditLogs(...)
    }

    AuditLogServiceImpl --> AuditLogRepository
    AuditLogRepository ..> AuditLog
}

package "Pillar 3: Messages Processing" <<Subsystem>> {
    class "ApiResponse<T>" as ApiResponse <<boundary>> {
        - status: int
        - message: String
        - data: T
        - timestamp: LocalDateTime
        + {static} success(data: T): ApiResponse<T>
        + {static} error(status: int, message: String): ApiResponse<T>
    }

    class "PageResponse<T>" as PageResponse <<boundary>> {
        - content: List<T>
        - totalElements: long
        - totalPages: int
        + {static} from(page: Page<T>): PageResponse<T>
    }

    class EmailServiceImpl <<control>> {
        - mailSender: JavaMailSender
        - emailLogRepository: EmailLogRepository
        + sendPasswordResetEmail(...)
        + sendRfqEmail(...)
    }

    class EmailLog <<entity>> {
        - toEmail: String
        - subject: String
        - body: String
        - status: Short
        - sentAt: LocalDateTime
    }

    EmailServiceImpl ..> EmailLog : persists message history
}

package "Application Controller / Service Layer" <<Client Code>> {
    class BusinessController <<control>> {
        + executeOperation(): ResponseEntity<ApiResponse<T>>
    }

    class BusinessServiceImpl <<control>> {
        - auditLogRepository: AuditLogRepository
        - logger: Logger
        + performBusinessLogic(): T
    }

    BusinessController --> BusinessServiceImpl : calls
}

BusinessController ..> ApiResponse : returns unified response
BusinessServiceImpl ..> CustomExceptions : throws on failure
BusinessServiceImpl ..> AuditLogRepository : records audit trail
GlobalExceptionHandler ..> ApiResponse : wraps error into unified format
BusinessServiceImpl ..> EmailServiceImpl : dispatches async notifications

@enduml