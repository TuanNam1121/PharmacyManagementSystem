@startuml CD03_Messages_Processing
title Common Design - Messages Processing Compact Class Diagram
scale 0.8
skinparam style strictuml
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam classAttributeIconSize 0
skinparam nodesep 18
skinparam ranksep 20
skinparam packagePadding 8
skinparam classPadding 2

skinparam class {
    BorderColor #000000
    BackgroundColor #7ACFF5
    HeaderBackgroundColor #7ACFF5
    FontColor #000000
    FontSize 10
    StereotypeFontColor #000000
    StereotypeFontSize 9
    ArrowColor #000000
}

package "com.pharmacy.dto" {
    class "ApiResponse<T>" as ApiResponse <<boundary>> {
        - status: int
        - message: String
        - data: T
        - timestamp: LocalDateTime
        + {static} success(data: T): ApiResponse<T>
        + {static} success(msg: String, data: T): ApiResponse<T>
        + {static} error(status: int, msg: String): ApiResponse<T>
    }

    class "PageResponse<T>" as PageResponse <<boundary>> {
        - content: List<T>
        - pageNumber: int
        - pageSize: int
        - totalElements: long
        - totalPages: int
        - last: boolean
        + {static} from(page: Page<T>): PageResponse<T>
    }
}

package "com.pharmacy.service" {
    interface EmailService <<control>> {
        + sendPasswordResetEmail(toEmail, username, resetToken): boolean
        + sendRfqEmail(rfq, supplier, token, url): boolean
    }

    class EmailServiceImpl <<control>> {
        - mailSender: JavaMailSender
        - emailLogRepository: EmailLogRepository
        + sendPasswordResetEmail(...): boolean
        + sendRfqEmail(...): boolean
    }

    EmailService <|.. EmailServiceImpl
}

package "com.pharmacy.entity" {
    class EmailLog <<entity>> {
        - id: Long
        - toEmail: String
        - subject: String
        - status: Short
        - sentAt: LocalDateTime
    }

    interface EmailLogRepository <<entity>> {
        + save(emailLog: EmailLog): EmailLog
    }

    EmailServiceImpl --> EmailLogRepository : logs status
    EmailLogRepository ..> EmailLog : manages
}

package "org.springframework.mail" {
    interface JavaMailSender {
        + send(mimeMessage: MimeMessage): void
    }
    EmailServiceImpl --> JavaMailSender : dispatches
}

@enduml